<script>
  // Mobile Menu Toggling logic
  const menuBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('close-mobile-menu');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileQuoteBtn = document.getElementById('mobile-quote-trigger');
  const headerQuoteBtn = document.getElementById('header-quote-btn');

  function syncActiveMobileLang() {
    const currentLang = document.documentElement.lang || 'en';
    mobileMenu?.querySelectorAll('.mobile-lang-pill').forEach((btn) => {
      const bLang = btn.getAttribute('data-lang');
      if (bLang === currentLang) {
        btn.className = 'mobile-lang-pill py-1.5 rounded text-center font-bold font-mono transition-all bg-neutral-900 text-white shadow-sm';
      } else {
        btn.className = 'mobile-lang-pill py-1.5 rounded text-center font-medium font-mono transition-all text-neutral-600 hover:text-neutral-900 hover:bg-neutral-200/70';
      }
    });
  }

  function openMenu() {
    mobileMenu?.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
    syncActiveMobileLang();
  }

  function closeMenu() {
    mobileMenu?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  menuBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  mobileMenu?.addEventListener('click', (e) => {
    if (e.target === mobileMenu) closeMenu();
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });

  // Connect Quote triggers to the global Quote Modal
  function triggerQuoteModal() {
    closeMenu();
    if ((window as any).openQuoteModal) {
      (window as any).openQuoteModal('General Wholesale Inquiry');
    }
    window.dispatchEvent(new CustomEvent('open-quote-modal', {
      detail: { productTitle: 'General Wholesale Inquiry' }
    }));
  }

  headerQuoteBtn?.addEventListener('click', triggerQuoteModal);
  mobileQuoteBtn?.addEventListener('click', triggerQuoteModal);

  // Language Switcher Options (Navigates to static language URL)
  document.querySelectorAll('.lang-select-opt, .mobile-lang-pill').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const lang = btn.getAttribute('data-lang');
      if (lang) {
        try {
          localStorage.setItem('aura_preferred_lang', lang);
        } catch {}

        const path = window.location.pathname;
        const cleanPath = path.replace(/^\/(zh|es|fr|de)(\/|$)/, '$2') || '/';
        const targetUrl = lang === 'en' ? cleanPath : `/${lang}${cleanPath === '/' ? '' : cleanPath}`;

        if (targetUrl !== window.location.pathname) {
          window.location.href = targetUrl;
          return;
        }

        if ((window as any).setAuraLang) {
          (window as any).setAuraLang(lang);
        }
      }
    });
  });
</script>
