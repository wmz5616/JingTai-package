---
import site from '../data/site.json';
---

<!-- Top Announcement Banner -->
<div class="bg-brand-dark text-neutral-300 text-xs py-2 px-4 border-b border-white/10 select-none">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center text-center gap-1 sm:gap-4">
    <div class="flex items-center space-x-2">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="font-medium text-white" data-i18n="nav_announcement_prefix">Guangzhou Supply Chain Hub:</span>
      <span class="text-neutral-400" data-i18n="nav_announcement">48-Hour Sample Dispatch • Low MOQ 1,000 Pcs • DDP Door-to-Door</span>
    </div>
    <div class="hidden md:flex items-center space-x-5 text-neutral-400 text-xs">
      <a href={`mailto:${site.email}`} class="hover:text-brand-gold transition-colors flex items-center space-x-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        <span>{site.email}</span>
      </a>
      <a href={site.whatsappDirectUrl} target="_blank" rel="noopener noreferrer" class="hover:text-brand-gold transition-colors flex items-center space-x-1">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        <span data-i18n="nav_whatsapp_chat">WhatsApp Quick Chat</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-neutral-200 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center space-x-3 group">
        <div class="w-10 h-10 bg-brand-dark flex items-center justify-center rounded-sm text-brand-gold font-serif font-bold text-xl tracking-tighter border border-brand-gold/40 shadow-sm group-hover:scale-105 transition-transform">
          A
        </div>
        <div class="flex flex-col">
          <span class="font-serif text-xl sm:text-2xl font-bold tracking-widest text-brand-dark leading-tight group-hover:text-brand-gold transition-colors">
            AURA
          </span>
          <span class="text-[9px] tracking-[0.25em] text-neutral-500 font-sans uppercase">
            Packaging • Guangzhou
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-7 text-sm font-medium text-neutral-700">
        <a href="/" class="hover:text-brand-gold transition-colors" data-i18n="nav_home">Home</a>
        
        <!-- Products Dropdown / Direct Link -->
        <div class="relative group">
          <a href="/products" class="inline-flex items-center space-x-1 hover:text-brand-gold py-2 transition-colors">
            <span data-i18n="nav_catalog">Product Catalog</span>
            <svg class="w-4 h-4 text-neutral-400 group-hover:text-brand-gold transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          
          <!-- Dropdown Menu -->
          <div class="absolute left-0 top-full hidden group-hover:block w-64 bg-white rounded-sm shadow-xl border border-neutral-200 py-2.5 z-50 animate-in fade-in slide-in-from-top-1 duration-200">
            <a href="/products" class="block px-4 py-2 text-xs font-semibold text-neutral-400 uppercase tracking-wider hover:bg-neutral-50" data-i18n="nav_all_collections">
              All Collections →
            </a>
            <div class="h-px bg-neutral-100 my-1"></div>
            <a href="/products?category=dropper" class="flex items-center justify-between px-4 py-2.5 text-sm text-neutral-800 hover:bg-neutral-50 hover:text-brand-gold transition-colors">
              <span data-i18n="nav_droppers">Dropper Bottles</span>
              <span class="text-xs text-neutral-400">15ml - 50ml</span>
            </a>
            <a href="/products?category=pump" class="flex items-center justify-between px-4 py-2.5 text-sm text-neutral-800 hover:bg-neutral-50 hover:text-brand-gold transition-colors">
              <span data-i18n="nav_pumps">Pump & Lotion</span>
              <span class="text-xs text-neutral-400">30ml - 100ml</span>
            </a>
            <a href="/products?category=jar" class="flex items-center justify-between px-4 py-2.5 text-sm text-neutral-800 hover:bg-neutral-50 hover:text-brand-gold transition-colors">
              <span data-i18n="nav_jars">Cream & Treatment Jars</span>
              <span class="text-xs text-neutral-400">15g - 50g</span>
            </a>
            <a href="/products?category=spray" class="flex items-center justify-between px-4 py-2.5 text-sm text-neutral-800 hover:bg-neutral-50 hover:text-brand-gold transition-colors">
              <span data-i18n="nav_spray">Mist Spray & Perfume</span>
              <span class="text-xs text-neutral-400">50ml - 100ml</span>
            </a>
          </div>
        </div>

        <a href="/#customization" class="hover:text-brand-gold transition-colors" data-i18n="nav_custom_finishes">Custom Finishes</a>
        
        <!-- Free Sample Kit CTA Link -->
        <a href="/sample-kit" class="relative hover:text-brand-gold transition-colors inline-flex items-center space-x-1">
          <span data-i18n="nav_free_sample">Free Sample Kit</span>
          <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-1.5 py-0.5 rounded tracking-wide border border-amber-300 animate-pulse" data-i18n="nav_free_badge">
            FREE
          </span>
        </a>

        <a href="/about" class="hover:text-brand-gold transition-colors" data-i18n="nav_about">About Us</a>
        <a href="/about#guangzhou-hub" class="hover:text-brand-gold transition-colors" data-i18n="nav_guangzhou_hub">Guangzhou Hub</a>
      </nav>

      <!-- Right Action Items -->
      <div class="flex items-center space-x-3 sm:space-x-4">
        
        <!-- Multi-Language Switcher Dropdown (Desktop) -->
        <div class="relative group" id="lang-switcher-container">
          <button
            type="button"
            class="flex items-center space-x-1.5 px-2.5 py-1.5 text-xs font-semibold text-neutral-700 bg-neutral-100 hover:bg-neutral-200 border border-neutral-300 rounded-sm transition-colors focus:outline-none"
            aria-label="Select Language"
          >
            <span class="current-lang-label">🇺🇸 EN</span>
            <svg class="w-3.5 h-3.5 text-neutral-500 group-hover:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          
          <div class="absolute right-0 top-full hidden group-hover:block w-36 bg-white rounded-sm shadow-xl border border-neutral-200 py-1.5 z-50 animate-in fade-in slide-in-from-top-1 duration-150 text-xs">
            <button type="button" class="w-full text-left px-3 py-2 flex items-center space-x-2 hover:bg-neutral-50 hover:text-brand-gold transition-colors lang-select-opt" data-lang="en">
              <span>🇺🇸</span>
              <span class="font-medium">English</span>
            </button>
            <button type="button" class="w-full text-left px-3 py-2 flex items-center space-x-2 hover:bg-neutral-50 hover:text-brand-gold transition-colors lang-select-opt" data-lang="zh">
              <span>🇨🇳</span>
              <span class="font-medium">简体中文</span>
            </button>
            <button type="button" class="w-full text-left px-3 py-2 flex items-center space-x-2 hover:bg-neutral-50 hover:text-brand-gold transition-colors lang-select-opt" data-lang="es">
              <span>🇪🇸</span>
              <span class="font-medium">Español</span>
            </button>
            <button type="button" class="w-full text-left px-3 py-2 flex items-center space-x-2 hover:bg-neutral-50 hover:text-brand-gold transition-colors lang-select-opt" data-lang="fr">
              <span>🇫🇷</span>
              <span class="font-medium">Français</span>
            </button>
            <button type="button" class="w-full text-left px-3 py-2 flex items-center space-x-2 hover:bg-neutral-50 hover:text-brand-gold transition-colors lang-select-opt" data-lang="de">
              <span>🇩🇪</span>
              <span class="font-medium">Deutsch</span>
            </button>
          </div>
        </div>

        <!-- RFQ Basket Trigger Button -->
        <button
          type="button"
          id="open-rfq-drawer"
          class="relative p-2.5 text-neutral-700 hover:text-brand-gold hover:bg-neutral-100 rounded-full transition-colors"
          title="View RFQ Basket"
          aria-label="View RFQ Basket"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          <span id="rfq-badge-count" class="absolute -top-0.5 -right-0.5 bg-brand-gold text-brand-dark text-[11px] font-bold w-4 h-4 rounded-full flex items-center justify-center shadow-sm">
            0
          </span>
        </button>

        <!-- Get a Quote Button (Desktop) -->
        <button
          type="button"
          id="header-quote-btn"
          class="hidden sm:inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold tracking-wide text-brand-dark bg-brand-gold hover:bg-brand-gold-light border border-brand-gold transition-all duration-300 shadow-sm hover:shadow-gold rounded-sm"
          data-i18n="nav_request_quote"
        >
          Request a Quote
        </button>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="lg:hidden p-2 text-neutral-700 hover:text-brand-gold hover:bg-neutral-100 rounded-sm transition-colors focus:outline-none"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu Overlay -->
  <div id="mobile-menu" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden transition-opacity">
    <div class="fixed top-0 right-0 bottom-0 w-80 max-w-full bg-white shadow-2xl p-6 flex flex-col justify-between overflow-y-auto">
      <div>
        <div class="flex items-center justify-between pb-6 border-b border-neutral-100">
          <div class="flex items-center space-x-2">
            <div class="w-8 h-8 bg-brand-dark flex items-center justify-center rounded-sm text-brand-gold font-serif font-bold text-base">A</div>
            <span class="font-serif font-bold tracking-widest text-lg">AURA PACKAGING</span>
          </div>
          <button id="close-mobile-menu" class="p-2 text-neutral-500 hover:text-neutral-900" aria-label="Close menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          </button>
        </div>

        <!-- Mobile Language Quick Pills -->
        <div class="py-4 border-b border-neutral-100">
          <span class="block text-xs font-semibold text-neutral-500 uppercase tracking-wider mb-2">Language:</span>
          <div class="flex flex-wrap gap-1.5 text-xs">
            <button type="button" class="px-2.5 py-1 bg-neutral-100 rounded border border-neutral-200 lang-select-opt" data-lang="en">🇺🇸 EN</button>
            <button type="button" class="px-2.5 py-1 bg-neutral-100 rounded border border-neutral-200 lang-select-opt" data-lang="zh">🇨🇳 中文</button>
            <button type="button" class="px-2.5 py-1 bg-neutral-100 rounded border border-neutral-200 lang-select-opt" data-lang="es">🇪🇸 ES</button>
            <button type="button" class="px-2.5 py-1 bg-neutral-100 rounded border border-neutral-200 lang-select-opt" data-lang="fr">🇫🇷 FR</button>
            <button type="button" class="px-2.5 py-1 bg-neutral-100 rounded border border-neutral-200 lang-select-opt" data-lang="de">🇩🇪 DE</button>
          </div>
        </div>

        <nav class="flex flex-col py-6 space-y-4 text-base font-medium text-neutral-800">
          <a href="/" class="py-2 hover:text-brand-gold border-b border-neutral-50" data-i18n="nav_home">Home</a>
          <a href="/products" class="py-2 hover:text-brand-gold border-b border-neutral-50" data-i18n="nav_catalog">Product Catalog</a>
          <a href="/products?category=dropper" class="pl-4 text-sm text-neutral-600 hover:text-brand-gold" data-i18n="nav_droppers">↳ Dropper Bottles</a>
          <a href="/products?category=pump" class="pl-4 text-sm text-neutral-600 hover:text-brand-gold" data-i18n="nav_pumps">↳ Pump & Lotion</a>
          <a href="/products?category=jar" class="pl-4 text-sm text-neutral-600 hover:text-brand-gold" data-i18n="nav_jars">↳ Cream & Treatment Jars</a>
          <a href="/products?category=spray" class="pl-4 text-sm text-neutral-600 hover:text-brand-gold" data-i18n="nav_spray">↳ Mist Spray & Perfume</a>
          <a href="/#customization" class="py-2 hover:text-brand-gold border-b border-neutral-50" data-i18n="nav_custom_finishes">Custom Finishes</a>
          <a href="/sample-kit" class="py-2 hover:text-brand-gold border-b border-neutral-50 flex items-center justify-between">
            <span data-i18n="nav_free_sample">Free Sample Kit</span>
            <span class="bg-amber-100 text-amber-800 text-xs px-2 py-0.5 rounded font-bold" data-i18n="nav_free_badge">FREE</span>
          </a>
          <a href="/about" class="py-2 hover:text-brand-gold border-b border-neutral-50" data-i18n="nav_about">About Factory & QA</a>
          <a href="/about#guangzhou-hub" class="py-2 hover:text-brand-gold border-b border-neutral-50" data-i18n="nav_guangzhou_hub">Guangzhou Supply Chain</a>
        </nav>
      </div>

      <div class="pt-6 border-t border-neutral-100 space-y-3">
        <button
          type="button"
          id="mobile-quote-trigger"
          class="w-full py-3 bg-brand-gold text-brand-dark font-semibold text-center rounded-sm shadow-sm hover:bg-brand-gold-light transition-colors"
          data-i18n="nav_request_quote"
        >
          Request Wholesale Quote
        </button>
        <a
          href={site.whatsappDirectUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full py-2.5 bg-emerald-600 text-white font-medium text-sm flex items-center justify-center space-x-2 rounded-sm hover:bg-emerald-700 transition-colors"
        >
          <span data-i18n="nav_whatsapp_chat">Chat on WhatsApp</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Toggling logic
  const menuBtn = document.getElementById('mobile-menu-toggle');
  const closeBtn = document.getElementById('close-mobile-menu');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileQuoteBtn = document.getElementById('mobile-quote-trigger');
  const headerQuoteBtn = document.getElementById('header-quote-btn');

  function openMenu() {
    mobileMenu?.classList.remove('hidden');
  }

  function closeMenu() {
    mobileMenu?.classList.add('hidden');
  }

  menuBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  mobileMenu?.addEventListener('click', (e) => {
    if (e.target === mobileMenu) closeMenu();
  });

  // Connect Quote triggers to the global Quote Modal
  function triggerQuoteModal() {
    closeMenu();
    window.dispatchEvent(new CustomEvent('open-quote-modal', {
      detail: { productTitle: 'General Wholesale Inquiry' }
    }));
  }

  headerQuoteBtn?.addEventListener('click', triggerQuoteModal);
  mobileQuoteBtn?.addEventListener('click', triggerQuoteModal);

  // Language Switcher Options
  document.querySelectorAll('.lang-select-opt').forEach((btn) => {
    btn.addEventListener('click', () => {
      const lang = btn.getAttribute('data-lang');
      if (lang && (window as any).setAuraLang) {
        (window as any).setAuraLang(lang);
      }
    });
  });
</script>
