---
import site from '../data/site.json';
import { getAssetUrl } from '../utils/assets';

const logoUrl = getAssetUrl(site.assets?.logo || '/images/logo.png');
---

<!-- Top Announcement Banner -->
<div class="bg-brand-dark text-neutral-300 text-xs py-2 px-4 border-b border-white/10 select-none">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row justify-between items-center text-center gap-1 sm:gap-4">
    <div class="flex flex-wrap items-center justify-center gap-x-2 text-center">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span class="font-medium text-white" data-i18n="nav_announcement_prefix">Guangzhou Supply Chain Hub:</span>
      <span class="text-neutral-400" data-i18n="nav_announcement">48-Hour Sample Dispatch • Low MOQ 1,000 Pcs • DDP Door-to-Door</span>
    </div>
    <div class="hidden md:flex items-center space-x-5 text-neutral-400 text-xs">
      <a href={`mailto:${site.email}`} class="hover:text-brand-gold transition-colors flex items-center space-x-1">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
        <span>{site.email}</span>
      </a>
      <!-- WeChat link in Chinese mode -->
      <button
        type="button"
        data-open-wechat
        class="contact-lang-zh hover:text-brand-gold transition-colors flex items-center space-x-1 cursor-pointer focus:outline-none"
      >
        <svg class="w-3.5 h-3.5 text-[#07C160]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M8.691 2.188C3.891 2.188 0 5.478 0 9.532c0 2.212 1.157 4.205 2.972 5.568l-.75 2.748 3.19-1.636c1.02.28 2.12.44 3.279.44.204 0 .405-.008.607-.021-.24-.707-.373-1.464-.373-2.253 0-4.054 3.891-7.344 8.691-7.344.296 0 .588.014.877.038C17.336 4.795 13.34 2.188 8.691 2.188zm-2.316 4.148c.677 0 1.226.549 1.226 1.226s-.549 1.226-1.226 1.226c-.676 0-1.225-.549-1.225-1.226s.549-1.226 1.225-1.226zm5.18 0c.677 0 1.226.549 1.226 1.226s-.549 1.226-1.226 1.226c-.677 0-1.226-.549-1.226-1.226s.549-1.226 1.226-1.226zm5.94 4.544c-4.106 0-7.435 2.82-7.435 6.297 0 3.478 3.329 6.297 7.435 6.297.915 0 1.792-.137 2.607-.386l2.454 1.258-.577-2.113c1.558-1.047 2.548-2.58 2.548-4.301 0-3.477-3.329-6.297-7.432-6.297zm-2.316 3.555c.58 0 1.05.47 1.05 1.051 0 .58-.47 1.05-1.05 1.05-.581 0-1.051-.47-1.051-1.05 0-.581.47-1.051 1.051-1.051zm4.436 0c.58 0 1.051.47 1.051 1.051 0 .58-.471 1.05-1.051 1.05-.58 0-1.05-.47-1.05-1.05 0-.581.47-1.051 1.05-1.051z"/>
        </svg>
        <span>微信业务直联 ({site.wechatFormatted})</span>
      </button>

      <!-- WhatsApp link in English mode -->
      <a href={site.whatsappDirectUrl} target="_blank" rel="noopener noreferrer" class="contact-lang-en hover:text-brand-gold transition-colors flex items-center space-x-1">
        <svg class="w-3.5 h-3.5 text-emerald-400" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
        <span data-i18n="nav_whatsapp_chat">WhatsApp Quick Chat</span>
      </a>
    </div>
  </div>
</div>

<!-- Main Sticky Header -->
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-neutral-200 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center space-x-3 group flex-shrink-0" aria-label="广州晶泰包装制品厂">
        <img
          src={logoUrl}
          alt="广州晶泰包装制品厂 JINGTAI PACKAGING"
          class="h-10 sm:h-11 w-auto object-contain transition-transform duration-300 group-hover:scale-[1.02]"
        />
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center space-x-3 xl:space-x-6 text-sm font-medium text-neutral-700 whitespace-nowrap">
        <a href="/" class="hover:text-brand-gold transition-colors flex-shrink-0" data-i18n="nav_home">Home</a>
        
        <!-- Products Dropdown / Direct Link -->
        <div class="relative group flex-shrink-0">
          <a href="/products" class="inline-flex items-center space-x-1 hover:text-brand-gold py-2 transition-colors whitespace-nowrap">
            <span data-i18n="nav_catalog">Product Catalog</span>
            <svg class="w-4 h-4 text-neutral-400 group-hover:text-brand-gold transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </a>
          
          <!-- Dropdown Menu -->
          <div class="absolute left-0 top-full hidden group-hover:block w-64 bg-white rounded-sm shadow-xl border border-neutral-200 py-2.5 z-50 animate-in fade-in slide-in-from-top-1 duration-200">
            <a href="/products" class="block px-4 py-2 text-xs font-semibold text-neutral-400 uppercase tracking-wider hover:bg-neutral-50" data-i18n="nav_all_collections">
              All Collections →
            </a>
            <div class="h-px bg-neutral-100 my-1"></div>
            <a href="/products?category=dropper" class="flex items-center justify-between px-4 py-2.5 text-sm text-neutral-800 hover:bg-neutral-50 hover:text-brand-gold transition-colors">
              <span data-i18n="nav_droppers">Dropper Bottles</span>
              <span class="text-xs text-neutral-400">15ml - 50ml</span>
            </a>
            <a href="/products?category=pump" class="flex items-center justify-between px-4 py-2.5 text-sm text-neutral-800 hover:bg-neutral-50 hover:text-brand-gold transition-colors">
              <span data-i18n="nav_pumps">Pump & Lotion</span>
              <span class="text-xs text-neutral-400">30ml - 100ml</span>
            </a>
            <a href="/products?category=jar" class="flex items-center justify-between px-4 py-2.5 text-sm text-neutral-800 hover:bg-neutral-50 hover:text-brand-gold transition-colors">
              <span data-i18n="nav_jars">Cream & Treatment Jars</span>
              <span class="text-xs text-neutral-400">15g - 50g</span>
            </a>
            <a href="/products?category=spray" class="flex items-center justify-between px-4 py-2.5 text-sm text-neutral-800 hover:bg-neutral-50 hover:text-brand-gold transition-colors">
              <span data-i18n="nav_spray">Mist Spray & Perfume</span>
              <span class="text-xs text-neutral-400">50ml - 100ml</span>
            </a>
          </div>
        </div>

        <a href="/#customization" class="hover:text-brand-gold transition-colors flex-shrink-0" data-i18n="nav_custom_finishes">Custom Finishes</a>
        
        <!-- Free Sample Kit CTA Link -->
        <a href="/sample-kit" class="relative hover:text-brand-gold transition-colors inline-flex items-center space-x-1 flex-shrink-0">
          <span data-i18n="nav_free_sample">Free Sample Kit</span>
          <span class="bg-amber-100 text-amber-800 text-[10px] font-bold px-1.5 py-0.5 rounded tracking-wide border border-amber-300 animate-pulse" data-i18n="nav_free_badge">
            FREE
          </span>
        </a>

        <a href="/about" class="hover:text-brand-gold transition-colors flex-shrink-0" data-i18n="nav_about">About Us</a>
        <a href="/about#guangzhou-hub" class="hover:text-brand-gold transition-colors flex-shrink-0" data-i18n="nav_guangzhou_hub">Guangzhou Hub</a>
      </nav>

      <!-- Right Action Items -->
      <div class="flex items-center space-x-2 sm:space-x-3 flex-shrink-0">
        
        <!-- Multi-Language Switcher Dropdown (Desktop) -->
        <div class="relative group hidden sm:block" id="lang-switcher-container">
          <button
            type="button"
            class="flex items-center justify-between w-[78px] px-2.5 py-1.5 text-xs font-semibold text-neutral-700 bg-neutral-100 hover:bg-neutral-200 border border-neutral-300 rounded-sm transition-colors focus:outline-none select-none"
            aria-label="Select Language"
          >
            <div class="flex items-center space-x-1">
              <svg class="w-3.5 h-3.5 text-neutral-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
              <span class="current-lang-label font-medium">EN</span>
            </div>
            <svg class="w-3 h-3 text-neutral-500 group-hover:rotate-180 transition-transform flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </button>
          
          <div class="absolute right-0 top-full hidden group-hover:block w-40 bg-white rounded-sm shadow-xl border border-neutral-200 py-1.5 z-50 animate-in fade-in slide-in-from-top-1 duration-150 text-xs">
            <button type="button" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-neutral-50 hover:text-brand-gold transition-colors lang-select-opt" data-lang="en">
              <span class="font-medium">English</span>
              <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 bg-neutral-100 rounded text-neutral-600">EN</span>
            </button>
            <button type="button" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-neutral-50 hover:text-brand-gold transition-colors lang-select-opt" data-lang="zh">
              <span class="font-medium">简体中文</span>
              <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 bg-neutral-100 rounded text-neutral-600">ZH</span>
            </button>
            <button type="button" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-neutral-50 hover:text-brand-gold transition-colors lang-select-opt" data-lang="es">
              <span class="font-medium">Español</span>
              <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 bg-neutral-100 rounded text-neutral-600">ES</span>
            </button>
            <button type="button" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-neutral-50 hover:text-brand-gold transition-colors lang-select-opt" data-lang="fr">
              <span class="font-medium">Français</span>
              <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 bg-neutral-100 rounded text-neutral-600">FR</span>
            </button>
            <button type="button" class="w-full text-left px-3 py-2 flex items-center justify-between hover:bg-neutral-50 hover:text-brand-gold transition-colors lang-select-opt" data-lang="de">
              <span class="font-medium">Deutsch</span>
              <span class="text-[10px] uppercase font-mono px-1.5 py-0.5 bg-neutral-100 rounded text-neutral-600">DE</span>
            </button>
          </div>
        </div>

        <!-- RFQ Basket Trigger Button -->
        <button
          type="button"
          id="open-rfq-drawer"
          class="relative p-2.5 text-neutral-700 hover:text-brand-gold hover:bg-neutral-100 rounded-full transition-colors flex-shrink-0"
          title="View RFQ Basket"
          aria-label="View RFQ Basket"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path>
          </svg>
          <span id="rfq-badge-count" class="absolute -top-0.5 -right-0.5 bg-brand-gold text-brand-dark text-[11px] font-bold w-4 h-4 rounded-full flex items-center justify-center shadow-sm">
            0
          </span>
        </button>

        <!-- Get a Quote Button (Desktop) -->
        <button
          type="button"
          id="header-quote-btn"
          class="quick-quote-btn hidden sm:inline-flex items-center justify-center px-4 py-2.5 text-sm font-semibold tracking-wide text-brand-dark bg-brand-gold hover:bg-brand-gold-light border border-brand-gold transition-colors duration-200 shadow-sm hover:shadow-gold rounded-sm whitespace-nowrap flex-shrink-0"
          data-product-title="General Wholesale Inquiry"
          data-i18n="nav_request_quote"
        >
          Request a Quote
        </button>

        <!-- Mobile Menu Toggle Button -->
        <button
          type="button"
          id="mobile-menu-toggle"
          class="lg:hidden p-2 text-neutral-700 hover:text-brand-gold hover:bg-neutral-100 rounded-sm transition-colors focus:outline-none"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>

      </div>
    </div>
  </div>
</header>

<!-- Mobile Drawer Menu Overlay (Porcelain White Luxury Theme) -->
<div id="mobile-menu" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden transition-opacity duration-300">
  <div class="fixed top-0 right-0 bottom-0 w-full max-w-[340px] sm:max-w-sm bg-white text-neutral-900 shadow-2xl flex flex-col justify-between overflow-hidden z-50 border-l border-neutral-200">
    
    <!-- 1. Drawer Header -->
    <div class="px-5 py-4 border-b border-neutral-100 flex items-center justify-between shrink-0 bg-white">
      <div class="flex items-center space-x-2.5">
        <img src={logoUrl} alt="广州晶泰包装制品厂" class="h-8 w-auto object-contain" />
      </div>
      <button
        type="button"
        id="close-mobile-menu"
        class="w-8 h-8 rounded-full bg-neutral-100 border border-neutral-200 hover:bg-neutral-200 flex items-center justify-center text-neutral-500 hover:text-neutral-900 transition-colors focus:outline-none cursor-pointer"
        aria-label="Close menu"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- 2. Language Segmented Pill Switcher -->
    <div class="px-5 py-3 border-b border-neutral-100 bg-neutral-50/70 shrink-0">
      <div class="flex items-center justify-between mb-1.5 px-0.5">
        <span class="text-[10px] font-mono tracking-widest uppercase text-neutral-400 font-semibold" data-zh="全球多语言站点" data-en="GLOBAL SITES">GLOBAL SITES</span>
        <span class="text-[10px] font-mono text-emerald-600 flex items-center gap-1">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span data-zh="广州外贸直供" data-en="DDP DIRECT">GLOBAL HUB</span>
        </span>
      </div>
      <div class="grid grid-cols-5 p-1 bg-neutral-100 rounded-lg border border-neutral-200 gap-1 text-xs">
        <button type="button" class="mobile-lang-pill py-1.5 rounded text-center font-medium font-mono transition-all text-neutral-600 hover:text-neutral-900 cursor-pointer" data-lang="en">EN</button>
        <button type="button" class="mobile-lang-pill py-1.5 rounded text-center font-medium transition-all text-neutral-600 hover:text-neutral-900 cursor-pointer" data-lang="zh">中文</button>
        <button type="button" class="mobile-lang-pill py-1.5 rounded text-center font-medium font-mono transition-all text-neutral-600 hover:text-neutral-900 cursor-pointer" data-lang="es">ES</button>
        <button type="button" class="mobile-lang-pill py-1.5 rounded text-center font-medium font-mono transition-all text-neutral-600 hover:text-neutral-900 cursor-pointer" data-lang="fr">FR</button>
        <button type="button" class="mobile-lang-pill py-1.5 rounded text-center font-medium font-mono transition-all text-neutral-600 hover:text-neutral-900 cursor-pointer" data-lang="de">DE</button>
      </div>
    </div>

    <!-- 3. Scrollable Navigation Content -->
    <div class="overflow-y-auto flex-1 px-5 py-4 space-y-5">
      
      <!-- Core Products Section -->
      <div>
        <div class="flex items-center justify-between pb-2 mb-2.5 border-b border-neutral-100">
          <span class="text-[11px] font-mono uppercase tracking-widest text-brand-gold-dark font-semibold" data-zh="核心瓶型系列" data-en="PRODUCT COLLECTIONS">PRODUCT COLLECTIONS</span>
          <a href="/products" class="text-xs text-neutral-500 hover:text-brand-gold-dark transition-colors flex items-center space-x-0.5 font-medium">
            <span data-zh="查看全部" data-en="View All">View All</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
          </a>
        </div>

        <!-- 2x2 Product Micro-Cards -->
        <div class="grid grid-cols-2 gap-2">
          <a href="/products?category=dropper" class="p-2.5 rounded-lg bg-neutral-50 hover:bg-neutral-100/80 border border-neutral-200/80 hover:border-brand-gold transition-all group flex flex-col justify-between min-h-[66px]">
            <div class="flex items-center justify-between text-neutral-500 group-hover:text-brand-gold-dark">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/></svg>
              <span class="text-[10px] font-mono text-neutral-400 bg-white px-1 py-0.2 rounded border border-neutral-200">15-50ml</span>
            </div>
            <span class="text-xs font-medium text-neutral-800 group-hover:text-brand-gold-dark" data-i18n="nav_droppers">Dropper Bottles</span>
          </a>

          <a href="/products?category=pump" class="p-2.5 rounded-lg bg-neutral-50 hover:bg-neutral-100/80 border border-neutral-200/80 hover:border-brand-gold transition-all group flex flex-col justify-between min-h-[66px]">
            <div class="flex items-center justify-between text-neutral-500 group-hover:text-brand-gold-dark">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/></svg>
              <span class="text-[10px] font-mono text-neutral-400 bg-white px-1 py-0.2 rounded border border-neutral-200">30-100ml</span>
            </div>
            <span class="text-xs font-medium text-neutral-800 group-hover:text-brand-gold-dark" data-i18n="nav_pumps">Pump & Lotion</span>
          </a>

          <a href="/products?category=jar" class="p-2.5 rounded-lg bg-neutral-50 hover:bg-neutral-100/80 border border-neutral-200/80 hover:border-brand-gold transition-all group flex flex-col justify-between min-h-[66px]">
            <div class="flex items-center justify-between text-neutral-500 group-hover:text-brand-gold-dark">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              <span class="text-[10px] font-mono text-neutral-400 bg-white px-1 py-0.2 rounded border border-neutral-200">15-50g</span>
            </div>
            <span class="text-xs font-medium text-neutral-800 group-hover:text-brand-gold-dark" data-i18n="nav_jars">Cream & Jars</span>
          </a>

          <a href="/products?category=spray" class="p-2.5 rounded-lg bg-neutral-50 hover:bg-neutral-100/80 border border-neutral-200/80 hover:border-brand-gold transition-all group flex flex-col justify-between min-h-[66px]">
            <div class="flex items-center justify-between text-neutral-500 group-hover:text-brand-gold-dark">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/></svg>
              <span class="text-[10px] font-mono text-neutral-400 bg-white px-1 py-0.2 rounded border border-neutral-200">50-100ml</span>
            </div>
            <span class="text-xs font-medium text-neutral-800 group-hover:text-brand-gold-dark" data-i18n="nav_spray">Mist & Spray</span>
          </a>
        </div>
      </div>

      <!-- VIP Free Sample Kit Card -->
