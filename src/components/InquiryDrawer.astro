---
import site from '../data/site.json';
---

<div
  id="rfq-drawer"
  class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden transition-opacity duration-300"
  aria-labelledby="rfq-drawer-title"
  role="dialog"
  aria-modal="true"
>
  <div class="fixed top-0 right-0 bottom-0 w-full max-w-md bg-white shadow-2xl flex flex-col justify-between overflow-hidden animate-in slide-in-from-right duration-300">
    
    <!-- Drawer Header -->
    <div class="p-4 sm:p-6 bg-brand-dark text-white flex items-center justify-between border-b border-neutral-800">
      <div>
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-brand-gold animate-pulse"></span>
          <h2 id="rfq-drawer-title" class="font-serif text-xl font-bold tracking-wide text-white" data-i18n="rfq_basket_title">
            RFQ Inquiry Basket
          </h2>
        </div>
        <p class="text-xs text-neutral-400 mt-0.5" data-i18n="rfq_basket_subtitle">
          Consolidate multiple packaging models for bulk quotation
        </p>
      </div>

      <button
        type="button"
        id="close-rfq-drawer"
        class="p-2 text-neutral-400 hover:text-white rounded-sm transition-colors"
        aria-label="Close basket"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Basket Items List Container -->
    <div class="flex-1 p-4 sm:p-6 overflow-y-auto space-y-4" id="rfq-items-list">
      <!-- Empty state template -->
      <div id="rfq-empty-state" class="py-16 text-center space-y-3">
        <div class="w-16 h-16 mx-auto bg-neutral-100 rounded-full flex items-center justify-center text-neutral-400">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        </div>
        <h3 class="font-serif font-bold text-neutral-800 text-lg" data-i18n="rfq_empty_title">Your RFQ Basket is Empty</h3>
        <p class="text-xs text-neutral-500 max-w-xs mx-auto" data-i18n="rfq_empty_desc">
          Browse our glass bottle collections and click "Add to RFQ" to bundle models for volume pricing.
        </p>
        <a
          href="/products"
          class="inline-block mt-2 px-4 py-2 bg-brand-dark text-white text-xs font-semibold rounded-sm hover:bg-neutral-800 transition-colors"
          data-i18n="rfq_explore_btn"
        >
          Explore Bottle Catalog →
        </a>
      </div>

      <!-- Dynamic Items Container -->
      <div id="rfq-dynamic-items" class="space-y-3"></div>
    </div>

    <!-- Drawer Footer Actions -->
    <div class="p-4 sm:p-6 bg-neutral-50 border-t border-neutral-200 space-y-3">
      <div class="flex items-center justify-between text-xs text-neutral-600 pb-1">
        <span data-i18n="rfq_sku_count">Packaging SKUs Selected:</span>
        <span id="rfq-item-count-text" class="font-bold text-brand-dark">0 SKUs</span>
      </div>

      <button
        type="button"
        id="rfq-submit-bundle-btn"
        class="w-full py-3.5 bg-brand-gold hover:bg-brand-gold-light text-brand-dark font-semibold text-sm rounded-sm tracking-wide shadow-gold transition-all flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed"
        disabled
      >
        <span data-i18n="rfq_submit_bundle">Request Bundle Quote for Selected Items →</span>
      </button>

      <button
        type="button"
        id="clear-rfq-basket"
        class="w-full py-2 text-center text-xs text-neutral-400 hover:text-neutral-700 transition-colors"
        data-i18n="rfq_clear_all"
      >
        Clear All Items
      </button>
    </div>

  </div>
</div>

<script>
  interface RFQItem {
    id: string;
    name: string;
    name_zh?: string;
    volume: string;
    image: string;
    moq: number;
  }

  const drawer = document.getElementById('rfq-drawer');
  const openBtn = document.getElementById('open-rfq-drawer');
  const closeBtn = document.getElementById('close-rfq-drawer');
  const emptyState = document.getElementById('rfq-empty-state');
  const dynamicContainer = document.getElementById('rfq-dynamic-items');
  const countText = document.getElementById('rfq-item-count-text');
  const badgeCount = document.getElementById('rfq-badge-count');
  const submitBundleBtn = document.getElementById('rfq-submit-bundle-btn') as HTMLButtonElement;
  const clearBtn = document.getElementById('clear-rfq-basket');

  function getBasket(): RFQItem[] {
    try {
      const data = localStorage.getItem('aura_rfq_basket');
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveBasket(items: RFQItem[]) {
    localStorage.setItem('aura_rfq_basket', JSON.stringify(items));
    renderBasket();
  }

  function openDrawer() {
    renderBasket();
    drawer?.classList.remove('hidden');
  }

  function closeDrawer() {
    drawer?.classList.add('hidden');
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) closeDrawer();
  });

  function renderBasket() {
    const items = getBasket();
    const isZh = document.documentElement.lang === 'zh';

    if (badgeCount) {
      badgeCount.textContent = items.length.toString();
      if (items.length === 0) {
        badgeCount.classList.add('hidden');
      } else {
        badgeCount.classList.remove('hidden');
      }
    }

    if (countText) {
      countText.textContent = isZh ? `${items.length} 款型号` : `${items.length} SKUs`;
    }

    if (items.length === 0) {
      emptyState?.classList.remove('hidden');
      if (dynamicContainer) dynamicContainer.innerHTML = '';
      if (submitBundleBtn) submitBundleBtn.disabled = true;
      return;
    }

    emptyState?.classList.add('hidden');
    if (submitBundleBtn) submitBundleBtn.disabled = false;

    if (dynamicContainer) {
      function sanitize(str: string): string {
        const div = document.createElement('div');
        div.textContent = str || '';
        return div.innerHTML;
      }

      function sanitizeUrl(url: string): string {
        try {
          const parsed = new URL(url, window.location.origin);
          if (parsed.protocol === 'http:' || parsed.protocol === 'https:') {
            return parsed.href.replace(/"/g, '&quot;');
          }
        } catch {}
        return 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=400&q=80';
      }

      dynamicContainer.innerHTML = items
        .map(
          (item) => {
            const displayName = sanitize(isZh ? (item.name_zh || item.name) : item.name);
            const safeImage = sanitizeUrl(item.image);
            const safeVolume = sanitize(item.volume);
            const safeId = sanitize(item.id);
            const safeMoq = Number.isFinite(item.moq) ? item.moq : 1000;
            return `
        <div class="p-3 bg-white border border-neutral-200 rounded-sm flex items-center space-x-3 hover:border-brand-gold/50 transition-colors">
          <img src="${safeImage}" alt="${displayName}" class="w-14 h-14 object-cover rounded bg-neutral-100 flex-shrink-0" onerror="this.src='https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=400&q=80';" />
          <div class="flex-1 min-w-0">
            <h4 class="text-xs font-bold text-neutral-900 truncate">${displayName}</h4>
            <div class="flex items-center space-x-2 text-[11px] text-neutral-500 mt-0.5">
              <span>${safeVolume}</span>
              <span>•</span>
              <span>${isZh ? '起订量:' : 'MOQ:'} ${safeMoq} pcs</span>
            </div>
          </div>
          <button type="button" class="remove-rfq-item text-neutral-300 hover:text-red-500 p-1 transition-colors" data-id="${safeId}" title="Remove item">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          </button>
        </div>
      `;
          }
        )
        .join('');

      dynamicContainer.querySelectorAll('.remove-rfq-item').forEach((btn) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const current = getBasket().filter((i) => i.id !== id);
          saveBasket(current);
        });
      });
    }
  }

  // Clear all items action
  clearBtn?.addEventListener('click', () => {
    saveBasket([]);
  });

  // Submit consolidated bundle quotation
  submitBundleBtn?.addEventListener('click', () => {
    const items = getBasket();
    if (items.length === 0) return;
    const isZh = document.documentElement.lang === 'zh';

    const itemTitles = items.map((i) => `${isZh ? (i.name_zh || i.name) : i.name} (${i.volume})`).join(' + ');
    closeDrawer();

    if ((window as any).openQuoteModal) {
      (window as any).openQuoteModal(itemTitles);
    }
  });

  // Listen to Add to RFQ events across the site
  document.addEventListener('click', (e) => {
    const target = (e.target as HTMLElement).closest('.add-to-rfq-btn');
    if (target) {
      const id = target.getAttribute('data-id');
      const name = target.getAttribute('data-name') || '';
      const name_zh = target.getAttribute('data-name-zh') || name;
      const volume = target.getAttribute('data-volume') || '';
      const image = target.getAttribute('data-image') || '';
      const moq = parseInt(target.getAttribute('data-moq') || '1000', 10);

      if (!id) return;

      const basket = getBasket();
      const existing = basket.find((i) => i.id === id);

      if (!existing) {
        basket.push({ id, name, name_zh, volume, image, moq });
        saveBasket(basket);
      }

      // Visual feedback
      const label = target.querySelector('span');
      if (label) {
        const isZh = document.documentElement.lang === 'zh';
        label.textContent = isZh ? '已加入清单' : 'Added to RFQ';
        setTimeout(() => {
          const currentIsZh = document.documentElement.lang === 'zh';
          label.textContent = currentIsZh ? '加入询价' : 'Add to RFQ';
        }, 1800);
      }

      openDrawer();
    }
  });

  // Re-render when language changes
  window.addEventListener('aura-language-changed', () => {
    renderBasket();
  });

  // Initial render on page load
  renderBasket();
</script>
