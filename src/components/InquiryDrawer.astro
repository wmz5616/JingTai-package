---
import site from '../data/site.json';
---

<div
  id="rfq-drawer"
  class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden transition-opacity duration-300"
  aria-labelledby="rfq-drawer-title"
  role="dialog"
  aria-modal="true"
>
  <div class="fixed top-0 right-0 bottom-0 w-full max-w-md bg-white shadow-2xl flex flex-col justify-between overflow-hidden animate-in slide-in-from-right duration-300">
    
    <!-- Drawer Header -->
    <div class="p-6 bg-brand-dark text-white flex items-center justify-between border-b border-neutral-800">
      <div>
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-brand-gold animate-pulse"></span>
          <h2 id="rfq-drawer-title" class="font-serif text-xl font-bold tracking-wide text-white" data-i18n="rfq_basket_title">
            RFQ Inquiry Basket
          </h2>
        </div>
        <p class="text-xs text-neutral-400 mt-0.5" data-i18n="rfq_basket_subtitle">
          Consolidate multiple packaging models for bulk quotation
        </p>
      </div>

      <button
        type="button"
        id="close-rfq-drawer"
        class="p-2 text-neutral-400 hover:text-white rounded-sm transition-colors"
        aria-label="Close basket"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
      </button>
    </div>

    <!-- Basket Items List Container -->
    <div class="flex-1 p-6 overflow-y-auto space-y-4" id="rfq-items-list">
      <!-- Empty state template -->
      <div id="rfq-empty-state" class="py-16 text-center space-y-3">
        <div class="w-16 h-16 mx-auto bg-neutral-100 rounded-full flex items-center justify-center text-neutral-400">
          <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
        </div>
        <h3 class="font-serif font-bold text-neutral-800 text-lg" data-i18n="rfq_empty_title">Your RFQ Basket is Empty</h3>
        <p class="text-xs text-neutral-500 max-w-xs mx-auto" data-i18n="rfq_empty_desc">
          Browse our glass bottle collections and click "Add to RFQ" to bundle models for volume pricing.
        </p>
        <a
          href="/products"
          class="inline-block mt-2 px-4 py-2 bg-brand-dark text-white text-xs font-semibold rounded-sm hover:bg-neutral-800 transition-colors"
          data-i18n="rfq_explore_btn"
        >
          Explore Bottle Catalog →
        </a>
      </div>

      <!-- Dynamic Items Container -->
      <div id="rfq-dynamic-items" class="space-y-3"></div>
    </div>

    <!-- Drawer Footer Actions -->
    <div class="p-6 bg-neutral-50 border-t border-neutral-200 space-y-3">
      <div class="flex items-center justify-between text-xs text-neutral-600 pb-1">
        <span>Packaging SKUs Selected:</span>
        <span id="rfq-item-count-text" class="font-bold text-brand-dark">0 SKUs</span>
      </div>

      <button
        type="button"
        id="rfq-submit-bundle-btn"
        class="w-full py-3.5 bg-brand-gold hover:bg-brand-gold-light text-brand-dark font-semibold text-sm rounded-sm tracking-wide shadow-gold transition-all flex items-center justify-center space-x-2 disabled:opacity-50 disabled:cursor-not-allowed"
        disabled
      >
        <span data-i18n="rfq_submit_bundle">Request Bundle Quote for Selected Items →</span>
      </button>

      <button
        type="button"
        id="clear-rfq-basket"
        class="w-full py-2 text-center text-xs text-neutral-400 hover:text-neutral-700 transition-colors"
        data-i18n="rfq_clear_all"
      >
        Clear All Items
      </button>
    </div>


  </div>
</div>

<script>
  interface RFQItem {
    id: string;
    name: string;
    volume: string;
    image: string;
    moq: number;
  }

  const drawer = document.getElementById('rfq-drawer');
  const openBtn = document.getElementById('open-rfq-drawer');
  const closeBtn = document.getElementById('close-rfq-drawer');
  const emptyState = document.getElementById('rfq-empty-state');
  const dynamicContainer = document.getElementById('rfq-dynamic-items');
  const countText = document.getElementById('rfq-item-count-text');
  const badgeCount = document.getElementById('rfq-badge-count');
  const submitBundleBtn = document.getElementById('rfq-submit-bundle-btn') as HTMLButtonElement;
  const clearBtn = document.getElementById('clear-rfq-basket');

  function getBasket(): RFQItem[] {
    try {
      const data = localStorage.getItem('aura_rfq_basket');
      return data ? JSON.parse(data) : [];
    } catch {
      return [];
    }
  }

  function saveBasket(items: RFQItem[]) {
    localStorage.setItem('aura_rfq_basket', JSON.stringify(items));
    renderBasket();
  }

  function openDrawer() {
    renderBasket();
    drawer?.classList.remove('hidden');
  }

  function closeDrawer() {
    drawer?.classList.add('hidden');
  }

  openBtn?.addEventListener('click', openDrawer);
  closeBtn?.addEventListener('click', closeDrawer);
  drawer?.addEventListener('click', (e) => {
    if (e.target === drawer) closeDrawer();
  });

  function renderBasket() {
    const items = getBasket();
    const count = items.length;

    if (badgeCount) badgeCount.innerText = count.toString();
    if (countText) countText.innerText = `${count} SKU${count === 1 ? '' : 's'}`;

    if (count === 0) {
      emptyState?.classList.remove('hidden');
      if (dynamicContainer) dynamicContainer.innerHTML = '';
      if (submitBundleBtn) submitBundleBtn.disabled = true;
      return;
    }

    emptyState?.classList.add('hidden');
    if (submitBundleBtn) submitBundleBtn.disabled = false;

    if (dynamicContainer) {
      dynamicContainer.innerHTML = items.map((item, idx) => `
        <div class="flex items-center space-x-3 p-3 bg-white rounded border border-neutral-200 shadow-sm">
          <img src="${item.image}" alt="${item.name}" class="w-14 h-14 object-cover rounded bg-neutral-100 flex-shrink-0" />
          <div class="flex-1 min-w-0">
            <h4 class="font-serif text-xs font-bold text-brand-dark truncate">${item.name}</h4>
            <p class="text-[11px] text-neutral-500">${item.volume} • MOQ: ${item.moq} pcs</p>
          </div>
          <button
            type="button"
            class="remove-rfq-item text-neutral-400 hover:text-red-500 p-1.5 transition-colors"
            data-index="${idx}"
            title="Remove"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
          </button>
        </div>
      `).join('');
    }
  }

  // Handle remove item
  dynamicContainer?.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.remove-rfq-item') as HTMLElement;
    if (btn) {
      const idx = parseInt(btn.dataset.index || '-1');
      if (idx >= 0) {
        const items = getBasket();
        items.splice(idx, 1);
        saveBasket(items);
      }
    }
  });

  // Handle clear all
  clearBtn?.addEventListener('click', () => {
    saveBasket([]);
  });

  // Handle Add to RFQ Click from anywhere on page
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.add-to-rfq-btn') as HTMLElement;
    if (btn) {
      const item: RFQItem = {
        id: btn.dataset.id || '',
        name: btn.dataset.name || '',
        volume: btn.dataset.volume || '',
        image: btn.dataset.image || '',
        moq: parseInt(btn.dataset.moq || '3000'),
      };

      const basket = getBasket();
      // Check if already in basket
      if (!basket.some(b => b.id === item.id)) {
        basket.push(item);
        saveBasket(basket);
      }

      // Visual feedback on button
      const span = btn.querySelector('span');
      if (span) {
        const orig = span.innerText;
        span.innerText = 'Added ✓';
        setTimeout(() => { span.innerText = orig; }, 1500);
      }

      openDrawer();
    }
  });

  // Submit consolidated bundle
  submitBundleBtn?.addEventListener('click', () => {
    const items = getBasket();
    const summary = items.map(i => `${i.name} (${i.volume})`).join(', ');
    closeDrawer();
    window.dispatchEvent(new CustomEvent('open-quote-modal', {
      detail: {
        productTitle: `Bundle RFQ (${items.length} SKUs): ${summary}`
      }
    }));
  });

  // Initial load
  renderBasket();
</script>
