---
import site from '../data/site.json';
---

<footer class="bg-brand-dark text-neutral-300 pt-16 pb-12 border-t border-neutral-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-neutral-800">
      
      <!-- Company Column -->
      <div class="lg:col-span-2 space-y-4">
        <div class="flex items-center space-x-3">
          <div class="w-9 h-9 bg-brand-gold text-brand-dark flex items-center justify-center font-serif font-bold text-lg rounded-sm">
            A
          </div>
          <span class="font-serif text-2xl font-bold tracking-widest text-white">
            {site.name}
          </span>
        </div>
        <p class="text-sm text-neutral-400 leading-relaxed max-w-md">
          {site.description}
        </p>
        <div class="pt-2 flex flex-wrap gap-2 text-xs">
          <span class="inline-flex items-center px-2.5 py-1 bg-neutral-800 text-neutral-300 rounded border border-neutral-700">
            ✓ Guangzhou Hub
          </span>
          <span class="inline-flex items-center px-2.5 py-1 bg-neutral-800 text-neutral-300 rounded border border-neutral-700">
            ✓ 1,000 MOQ Trial Orders
          </span>
          <span class="inline-flex items-center px-2.5 py-1 bg-neutral-800 text-neutral-300 rounded border border-neutral-700">
            ✓ DDP Door-to-Door Freight
          </span>
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-brand-gold uppercase tracking-wider font-sans">
          Products & Solutions
        </h3>
        <ul class="space-y-2 text-sm text-neutral-400">
          <li><a href="/products?category=dropper" class="hover:text-white transition-colors">Dropper Bottles (15-50ml)</a></li>
          <li><a href="/products?category=pump" class="hover:text-white transition-colors">Serum & Lotion Pumps</a></li>
          <li><a href="/products?category=jar" class="hover:text-white transition-colors">Heavy-Base Cream Jars</a></li>
          <li><a href="/products?category=spray" class="hover:text-white transition-colors">Perfume & Mist Sprayers</a></li>
          <li><a href="/products" class="hover:text-white transition-colors">View All Packaging →</a></li>
        </ul>
      </div>

      <!-- OEM & Services -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-brand-gold uppercase tracking-wider font-sans">
          OEM & Sourcing
        </h3>
        <ul class="space-y-2 text-sm text-neutral-400">
          <li><a href="/sample-kit" class="hover:text-white transition-colors text-amber-300 font-medium">Free Sample Kit Request</a></li>
          <li><a href="/#customization" class="hover:text-white transition-colors">Surface Decoration & Printing</a></li>
          <li><a href="/about" class="hover:text-white transition-colors">Quality Control & AQL 2.5</a></li>
          <li><a href="/about#guangzhou-hub" class="hover:text-white transition-colors">Guangzhou Supply Chain Hub</a></li>
          <li><a href="/#faq" class="hover:text-white transition-colors">B2B Trade FAQs</a></li>
        </ul>
      </div>

      <!-- Contact & Hours -->
      <div class="space-y-3">
        <h3 class="text-xs font-semibold text-brand-gold uppercase tracking-wider font-sans">
          Inquiry & Direct Sales
        </h3>
        <div class="space-y-2.5 text-sm text-neutral-400">
          <p class="flex items-start space-x-2">
            <span class="text-brand-gold font-mono">Mail:</span>
            <a href={`mailto:${site.email}`} class="hover:text-white transition-colors underline">{site.email}</a>
          </p>
          <p class="flex items-start space-x-2">
            <span class="text-emerald-400 font-mono">WA:</span>
            <a href={site.whatsappDirectUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">{site.whatsappFormatted}</a>
          </p>
          <p class="text-xs text-neutral-500 pt-1">
            📍 {site.location}
          </p>
          <p class="text-xs text-emerald-400/90 font-medium bg-emerald-950/40 p-2 rounded border border-emerald-800/40">
            ⚡ {site.responseCommitment}
          </p>
        </div>
      </div>

    </div>

    <!-- International Compliance Badges -->
    <div class="py-8 border-b border-neutral-800">
      <p class="text-xs text-neutral-400 uppercase tracking-widest text-center mb-4 font-semibold">
        Global Compliance & Export Certifications
      </p>
      <div class="flex flex-wrap justify-center items-center gap-6 sm:gap-10 text-xs text-neutral-400">
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
          <span>ISO 9001:2015 Quality System</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
          <span>FDA 21 CFR Food-Contact Safe</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
          <span>EU 1223/2009 Cosmetic Standard</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-brand-gold"></span>
          <span>California Prop 65 Lead-Free</span>
        </div>
        <div class="flex items-center space-x-2">
          <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
          <span>100% Recyclable Flint Glass (PCR Ready)</span>
        </div>
      </div>
    </div>

    <!-- Copyright & Disclaimer -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-neutral-500 gap-4">
      <p>
        © {new Date().getFullYear()} {site.companyName}. All rights reserved.
      </p>
      <div class="flex items-center space-x-6">
        <a href="/about" class="hover:text-neutral-400">Privacy Policy</a>
        <a href="/about" class="hover:text-neutral-400">Terms of Supply</a>
        <a href="/sample-kit" class="hover:text-brand-gold text-neutral-400 font-medium">Request Free Sample Kit</a>
      </div>
    </div>

  </div>
</footer>
