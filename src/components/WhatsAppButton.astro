---
import site from "../data/site.json";
---

<aside aria-label="Quick contact widget">
  <!-- 1. Chinese WeChat Floating Button (Active when html[lang="zh"]) -->
  <button
    type="button"
    data-open-wechat
    class="contact-lang-zh fixed bottom-5 right-4 sm:bottom-6 sm:right-6 z-40 group flex items-center bg-transparent border-0 p-0 rounded-full focus:outline-none cursor-pointer"
    aria-label="打开微信官方业务直联"
  >
    <!-- Pulsing ambient ring -->
    <span
      class="absolute -inset-1 rounded-full bg-[#07C160] opacity-30 group-hover:opacity-60 animate-ping pointer-events-none"
    ></span>

    <!-- WeChat Capsule Button -->
    <div
      class="relative bg-[#07C160] hover:bg-[#06ad56] text-white p-3.5 sm:px-4 sm:py-3.5 rounded-full flex items-center space-x-2.5 transition-all duration-300 transform group-hover:scale-105 shadow-xl"
    >
      <!-- SVG WeChat Icon -->
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
        <path
          d="M8.691 2.188C3.891 2.188 0 5.478 0 9.532c0 2.212 1.157 4.205 2.972 5.568l-.75 2.748 3.19-1.636c1.02.28 2.12.44 3.279.44.204 0 .405-.008.607-.021-.24-.707-.373-1.464-.373-2.253 0-4.054 3.891-7.344 8.691-7.344.296 0 .588.014.877.038C17.336 4.795 13.34 2.188 8.691 2.188zm-2.316 4.148c.677 0 1.226.549 1.226 1.226s-.549 1.226-1.226 1.226c-.676 0-1.225-.549-1.225-1.226s.549-1.226 1.225-1.226zm5.18 0c.677 0 1.226.549 1.226 1.226s-.549 1.226-1.226 1.226c-.677 0-1.226-.549-1.226-1.226s.549-1.226 1.226-1.226zm5.94 4.544c-4.106 0-7.435 2.82-7.435 6.297 0 3.478 3.329 6.297 7.435 6.297.915 0 1.792-.137 2.607-.386l2.454 1.258-.577-2.113c1.558-1.047 2.548-2.58 2.548-4.301 0-3.477-3.329-6.297-7.432-6.297zm-2.316 3.555c.58 0 1.05.47 1.05 1.051 0 .58-.47 1.05-1.05 1.05-.581 0-1.051-.47-1.051-1.05 0-.581.47-1.051 1.051-1.051zm4.436 0c.58 0 1.051.47 1.051 1.051 0 .58-.471 1.05-1.051 1.05-.58 0-1.05-.47-1.05-1.05 0-.581.47-1.051 1.05-1.051z"
        ></path>
      </svg>
      <span class="hidden sm:inline-block font-medium text-xs tracking-wide">
        微信在线咨询
      </span>
    </div>
  </button>

  <!-- 2. English WhatsApp Floating Button (Active when html[lang="en"]) -->
  <a
    href={site.whatsappDirectUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="contact-lang-en fixed bottom-5 right-4 sm:bottom-6 sm:right-6 z-40 group flex items-center bg-transparent border-0 p-0 rounded-full focus:outline-none"
    aria-label="Direct WhatsApp Contact with Packaging Engineer"
  >
    <!-- Pulsing ambient ring -->
    <span
      class="absolute -inset-1 rounded-full bg-emerald-500 opacity-30 group-hover:opacity-60 animate-ping pointer-events-none"
    ></span>

    <!-- Tooltip on hover -->
    <div
      class="hidden sm:block absolute right-full mr-3.5 top-1/2 -translate-y-1/2 opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none translate-x-2 group-hover:translate-x-0 whitespace-nowrap"
    >
      <div
        class="bg-brand-dark text-white text-xs py-2 px-3.5 rounded-sm shadow-xl border border-neutral-700 flex items-center space-x-2"
      >
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Guangzhou Specialist: 2-4H Fast RFQ</span>
      </div>
    </div>

    <!-- WhatsApp Capsule Button -->
    <div
      class="relative bg-[#25D366] hover:bg-[#20bd5a] text-white p-3.5 sm:px-4 sm:py-3.5 rounded-full flex items-center space-x-2.5 transition-all duration-300 transform group-hover:scale-105 shadow-xl"
    >
      <!-- SVG WhatsApp Icon -->
      <svg class="w-6 h-6 fill-current" viewBox="0 0 24 24">
        <path
          d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"
        ></path>
      </svg>
      <span class="hidden sm:inline-block font-medium text-xs tracking-wide">
        WhatsApp Fast RFQ
      </span>
    </div>
  </a>
</aside>
