---
import Layout from '../../layouts/Layout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Button from '../../components/Button.astro';
import Badge from '../../components/Badge.astro';
import products from '../../data/products.json';
import site from '../../data/site.json';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params;
const featuredProducts = products.filter((p) => p.isFeatured);

let pageTitle = `${site.name} | Luxury Cosmetic Glass Packaging & Turnkey Supply Chain`;
let pageDesc = site.description;

if (lang === 'zh') {
  pageTitle = `${site.name} | 广州高端美妆玻璃包材源头供应链 • 现货小批量起订`;
  pageDesc = site.description_zh;
} else if (lang === 'es') {
  pageTitle = `${site.name} | Envases de Vidrio Cosmético de Lujo y Cadena de Suministro`;
  pageDesc = "Su socio integral de envases cosméticos en Guangzhou. Botellas de vidrio de alta pureza, bombas dosificadoras de precisión y envíos DDP puerta a puerta.";
} else if (lang === 'fr') {
  pageTitle = `${site.name} | Emballages en Verre Cosmétique Haut de Gamme`;
  pageDesc = "Votre partenaire d'emballage cosmétique clé en main à Guangzhou. Flacons en verre de haute qualité, pompes de précision et livraison DDP.";
} else if (lang === 'de') {
  pageTitle = `${site.name} | Erstklassige Glasverpackungen für Kosmetik`;
  pageDesc = "Ihr Komplettpartner für Kosmetikverpackungen in Guangzhou. Hochweißes Glas, Präzisionspumpen und DDP-Lieferung ab 1.000 Stück.";
}
---

<Layout
  lang={lang}
  title={pageTitle}
  title_zh={`${site.name} | 广州高端美妆玻璃包材源头供应链 • 现货小批量起订`}
  description={pageDesc}
  description_zh={site.description_zh}
>
  <!-- 1. HERO SECTION -->
  <section class="relative bg-brand-dark text-white overflow-hidden py-24 sm:py-32 lg:py-36 border-b border-neutral-800">
    <!-- Atmospheric Ambient Glows -->
    <div class="absolute top-0 right-1/4 w-96 h-96 bg-brand-gold/10 rounded-full blur-3xl pointer-events-none"></div>
    <div class="absolute bottom-0 left-10 w-80 h-80 bg-neutral-800/40 rounded-full blur-2xl pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
        
        <!-- Hero Text Content -->
        <div class="lg:col-span-7 space-y-7 text-center lg:text-left">
          
          <div class="inline-flex items-center space-x-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs text-neutral-300">
            <span class="w-2 h-2 rounded-full bg-brand-gold animate-ping"></span>
            <span class="text-brand-gold font-semibold uppercase tracking-wider" data-i18n="hero_tag">Guangzhou Supply Chain Hub • ISO 9001 & GMP Certified Alliances</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-5xl lg:text-6xl font-bold tracking-tight text-white leading-[1.15]" data-i18n="hero_title">
            Architectural Glass Packaging for Prestige Skincare & Perfumery
          </h1>

          <p class="text-base sm:text-lg text-neutral-300 max-w-2xl mx-auto lg:mx-0 font-light leading-relaxed" data-i18n="hero_desc">
            Your turnkey cosmetic packaging partner in Guangzhou. Engineered for indie beauty founders, clinical formulators, and luxury skincare brands. We supply high-flint glass bottles, precision dispensing systems, custom surface decoration, and DDP door-to-door shipping with flexible low MOQ from 1,000 pcs.
          </p>

          <!-- CTAs -->
          <div class="pt-2 flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4">
            <Button href={`/${lang}/sample-kit`} variant="gold" size="lg" class="w-full sm:w-auto shadow-gold">
              <span data-i18n="hero_cta_sample">Order Free Sample Kit</span>
              <span class="bg-brand-dark/20 text-brand-dark text-xs px-2 py-0.5 rounded font-bold ml-1" data-i18n="nav_free_badge">FREE</span>
            </Button>
            <Button href={`/${lang}/products`} variant="outline" size="lg" class="w-full sm:w-auto text-white border-neutral-600 hover:border-brand-gold hover:text-brand-gold">
              <span data-i18n="hero_cta_catalog">Explore 2026 Catalog →</span>
            </Button>
          </div>

          <!-- Trust Value Pillars -->
          <div class="pt-6 border-t border-white/10 grid grid-cols-2 sm:grid-cols-4 gap-4 text-left">
            <div class="min-h-[58px] flex flex-col justify-start">
              <span class="block text-2xl font-bold font-serif text-brand-gold">48H</span>
              <span class="text-xs text-neutral-400" data-i18n="stat_48h">Sample Dispatch</span>
            </div>
            <div class="min-h-[58px] flex flex-col justify-start">
              <span class="block text-2xl font-bold font-serif text-brand-gold">1,000+</span>
              <span class="text-xs text-neutral-400" data-i18n="stat_1000">Low Trial MOQ</span>
            </div>
            <div class="min-h-[58px] flex flex-col justify-start">
              <span class="block text-2xl font-bold font-serif text-brand-gold">100%</span>
              <span class="text-xs text-neutral-400" data-i18n="stat_100">Leak Vacuum QA</span>
            </div>
            <div class="min-h-[58px] flex flex-col justify-start">
              <span class="block text-2xl font-bold font-serif text-brand-gold">DDP</span>
              <span class="text-xs text-neutral-400" data-i18n="stat_ddp">Door-to-Door US/EU</span>
            </div>
          </div>

        </div>

        <!-- Hero Visual Showcase -->
        <div class="lg:col-span-5 relative flex justify-center">
          <div class="relative w-full max-w-md aspect-[4/5] rounded-sm overflow-hidden border border-white/10 shadow-2xl group">
            <img
              src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=1000&q=85"
              alt="Luxury cosmetic glass bottles showcase"
              onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1556228720-195a672e8a03?auto=format&fit=crop&w=1000&q=85';"
              class="w-full h-full object-cover object-center transform group-hover:scale-105 transition-transform duration-700"
            />
            
            <!-- Glass Floating Info Badge -->
            <div class="absolute bottom-4 inset-x-4 glass-dark p-4 rounded-sm border border-white/10 space-y-1">
              <div class="flex items-center justify-between text-xs text-brand-gold font-mono">
                <span data-zh="高定奢品滴管系列" data-en="PRESTIGE DROPPER LINE">PRESTIGE DROPPER LINE</span>
                <span>DIN 18/410</span>
              </div>
              <p class="text-xs text-neutral-300" data-zh="药用级高白料玻璃配精密刻度滴管与电镀金中套，承诺零析出与零渗漏。" data-en="USP Type III high flint amber glass with precision pipette & gold collar. Zero leaching guarantee.">
                USP Type III high flint amber glass with precision pipette & gold collar. Zero leaching guarantee.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- 2. QUICK CATEGORY HUBS -->
  <section class="py-12 bg-white border-b border-neutral-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        
        <a href={`/${lang}/products?category=dropper`} class="p-3.5 sm:p-5 rounded-sm border border-neutral-200 hover:border-brand-gold hover:shadow-md transition-all group bg-neutral-50/50 hover:bg-white flex flex-col justify-between h-full min-h-[120px]">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-semibold text-brand-gold uppercase" data-i18n="cat_01_tag">01 / Dropper</span>
              <span class="text-xs text-neutral-400 group-hover:text-brand-gold group-hover:translate-x-1 transition-transform">→</span>
            </div>
            <h3 class="font-serif font-bold text-neutral-900 text-base group-hover:text-brand-gold transition-colors leading-snug min-h-[1.5rem]" data-i18n="cat_01_title">
              Dropper Bottles
            </h3>
          </div>
          <p class="text-xs text-neutral-500 mt-2 min-h-[2rem] leading-relaxed" data-i18n="cat_01_desc">15ml, 30ml, 50ml for Serums & Oils</p>
        </a>

        <a href={`/${lang}/products?category=pump`} class="p-3.5 sm:p-5 rounded-sm border border-neutral-200 hover:border-brand-gold hover:shadow-md transition-all group bg-neutral-50/50 hover:bg-white flex flex-col justify-between h-full min-h-[120px]">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-semibold text-brand-gold uppercase" data-i18n="cat_02_tag">02 / Pump</span>
              <span class="text-xs text-neutral-400 group-hover:text-brand-gold group-hover:translate-x-1 transition-transform">→</span>
            </div>
            <h3 class="font-serif font-bold text-neutral-900 text-base group-hover:text-brand-gold transition-colors leading-snug min-h-[1.5rem]" data-i18n="cat_02_title">
              Pump & Lotion Bottles
            </h3>
          </div>
          <p class="text-xs text-neutral-500 mt-2 min-h-[2rem] leading-relaxed" data-i18n="cat_02_desc">External-spring treatment pumps</p>
        </a>

        <a href={`/${lang}/products?category=jar`} class="p-3.5 sm:p-5 rounded-sm border border-neutral-200 hover:border-brand-gold hover:shadow-md transition-all group bg-neutral-50/50 hover:bg-white flex flex-col justify-between h-full min-h-[120px]">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-semibold text-brand-gold uppercase" data-i18n="cat_03_tag">03 / Jars</span>
              <span class="text-xs text-neutral-400 group-hover:text-brand-gold group-hover:translate-x-1 transition-transform">→</span>
            </div>
            <h3 class="font-serif font-bold text-neutral-900 text-base group-hover:text-brand-gold transition-colors leading-snug min-h-[1.5rem]" data-i18n="cat_03_title">
              Cream & Face Jars
            </h3>
          </div>
          <p class="text-xs text-neutral-500 mt-2 min-h-[2rem] leading-relaxed" data-i18n="cat_03_desc">Heavy bottom thick-wall cosmetic pots</p>
        </a>

        <a href={`/${lang}/products?category=spray`} class="p-3.5 sm:p-5 rounded-sm border border-neutral-200 hover:border-brand-gold hover:shadow-md transition-all group bg-neutral-50/50 hover:bg-white flex flex-col justify-between h-full min-h-[120px]">
          <div>
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-mono font-semibold text-brand-gold uppercase" data-i18n="cat_04_tag">04 / Spray</span>
              <span class="text-xs text-neutral-400 group-hover:text-brand-gold group-hover:translate-x-1 transition-transform">→</span>
            </div>
            <h3 class="font-serif font-bold text-neutral-900 text-base group-hover:text-brand-gold transition-colors leading-snug min-h-[1.5rem]" data-i18n="cat_04_title">
              Perfume & Mist Sprayers
            </h3>
          </div>
          <p class="text-xs text-neutral-500 mt-2 min-h-[2rem] leading-relaxed" data-i18n="cat_04_desc">Ultra-fine micro atomization flacons</p>
        </a>

      </div>
    </div>
  </section>

  <!-- 3. FEATURED PACKAGING LINE (PRODUCTS GRID) -->
  <section class="py-20 bg-[#faf9f6]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div class="space-y-2">
          <div class="flex items-center space-x-2 text-xs font-mono text-brand-gold uppercase tracking-widest" data-i18n="feat_tag_line">
            Signature Line • Ready for Bulk Run
          </div>
          <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-dark" data-i18n="feat_title">
            Best-Selling Packaging Collections
          </h2>
          <p class="text-sm text-neutral-600 max-w-xl" data-i18n="feat_desc">
            Pharmaceutical-grade glass bottles engineered for clean beauty, anti-aging serums, and dermatological formulations.
          </p>
        </div>

        <a
          href={`/${lang}/products`}
          class="inline-flex items-center space-x-2 text-sm font-semibold text-brand-dark hover:text-brand-gold transition-colors pb-1 border-b border-neutral-300 hover:border-brand-gold"
        >
          <span data-i18n="feat_view_all">View All 10+ Models & Specifications →</span>
        </a>
      </div>

      <!-- Product Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {featuredProducts.map((product) => (
          <ProductCard product={product} lang={lang} />
        ))}
      </div>

    </div>
  </section>

  <!-- 4. TURNKEY CUSTOMIZATION & SURFACE FINISHES SHOWCASE -->
  <section id="customization" class="py-20 bg-white border-y border-neutral-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto space-y-3 mb-16">
        <Badge variant="gold" size="sm">
          <span data-i18n="finish_badge">Bespoke OEM / ODM Capabilities</span>
        </Badge>
        <h2 class="font-serif text-3xl sm:text-4xl font-bold text-brand-dark" data-i18n="finish_title">
          Surface Finishing & Decoration Artistry
        </h2>
        <p class="text-sm sm:text-base text-neutral-600" data-i18n="finish_desc">
          Transform standard glass bottles into iconic prestige packaging. Our Guangzhou finishing facilities offer precise Pantone color matching, tactile texturing, and luxury metal accents.
        </p>
      </div>

      <!-- 6 Key Finishing Techniques Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <div class="p-6 rounded-sm border border-neutral-200 bg-neutral-50/60 hover:bg-white hover:border-brand-gold hover:shadow-lg transition-all flex flex-col justify-between h-full">
          <div>
            <div class="w-10 h-10 rounded-sm bg-neutral-900 text-brand-gold flex items-center justify-center font-serif font-bold text-lg mb-3">
              01
            </div>
            <h3 class="font-serif font-bold text-lg text-brand-dark leading-snug min-h-[1.75rem]" data-i18n="finish_1_title">Acid Frosted & Satin Etching</h3>
            <p class="text-xs text-neutral-600 leading-relaxed mt-2 min-h-[3.5rem]" data-i18n="finish_1_desc">
              Uniform velvet-touch matte texture that resists fingerprints and creates an ethereal frosted glow for sensitive retinol and vitamin serums.
            </p>
          </div>
          <span class="inline-block text-[11px] font-mono text-brand-gold-dark font-medium mt-4 pt-2 border-t border-neutral-200/60" data-i18n="finish_1_tag">MOQ: 3,000 pcs • Sample in 5 days</span>
        </div>

        <div class="p-6 rounded-sm border border-neutral-200 bg-neutral-50/60 hover:bg-white hover:border-brand-gold hover:shadow-lg transition-all flex flex-col justify-between h-full">
          <div>
            <div class="w-10 h-10 rounded-sm bg-neutral-900 text-brand-gold flex items-center justify-center font-serif font-bold text-lg mb-3">
              02
            </div>
            <h3 class="font-serif font-bold text-lg text-brand-dark leading-snug min-h-[1.75rem]" data-i18n="finish_2_title">Precision Silk-Screen Printing</h3>
            <p class="text-xs text-neutral-600 leading-relaxed mt-2 min-h-[3.5rem]" data-i18n="finish_2_desc">
              High-definition organic and ceramic ink printing with crisp typography down to 4pt font. Scratch-resistant curing tested with 3M adhesive tape peel tests.
            </p>
          </div>
          <span class="inline-block text-[11px] font-mono text-brand-gold-dark font-medium mt-4 pt-2 border-t border-neutral-200/60" data-i18n="finish_2_tag">Pantone C Match • 1-4 Spot Colors</span>
        </div>

        <div class="p-6 rounded-sm border border-neutral-200 bg-neutral-50/60 hover:bg-white hover:border-brand-gold hover:shadow-lg transition-all flex flex-col justify-between h-full">
          <div>
            <div class="w-10 h-10 rounded-sm bg-neutral-900 text-brand-gold flex items-center justify-center font-serif font-bold text-lg mb-3">
              03
            </div>
            <h3 class="font-serif font-bold text-lg text-brand-dark leading-snug min-h-[1.75rem]" data-i18n="finish_3_title">Hot Foil Stamping (Gold / Rose)</h3>
            <p class="text-xs text-neutral-600 leading-relaxed mt-2 min-h-[3.5rem]" data-i18n="finish_3_desc">
              Genuine metallic foil applied under high pressure and heat. Yields brilliant mirror-reflective luxury branding that elevates price perception in Sephora and Ulta.
            </p>
          </div>
          <span class="inline-block text-[11px] font-mono text-brand-gold-dark font-medium mt-4 pt-2 border-t border-neutral-200/60" data-i18n="finish_3_tag">Gold, Silver, Rose Gold, Holographic</span>
        </div>

        <div class="p-6 rounded-sm border border-neutral-200 bg-neutral-50/60 hover:bg-white hover:border-brand-gold hover:shadow-lg transition-all flex flex-col justify-between h-full">
          <div>
            <div class="w-10 h-10 rounded-sm bg-neutral-900 text-brand-gold flex items-center justify-center font-serif font-bold text-lg mb-3">
              04
            </div>
            <h3 class="font-serif font-bold text-lg text-brand-dark leading-snug min-h-[1.75rem]" data-i18n="finish_4_title">Gradient Spray Coating</h3>
            <p class="text-xs text-neutral-600 leading-relaxed mt-2 min-h-[3.5rem]" data-i18n="finish_4_desc">
              Smooth ombre transitions from opaque base to transparent shoulder. Water-based eco-friendly lacquer compliant with European REACH heavy metal standards.
            </p>
          </div>
          <span class="inline-block text-[11px] font-mono text-brand-gold-dark font-medium mt-4 pt-2 border-t border-neutral-200/60" data-i18n="finish_4_tag">Glossy, Semi-Matte, or Velvet Finish</span>
        </div>

        <div class="p-6 rounded-sm border border-neutral-200 bg-neutral-50/60 hover:bg-white hover:border-brand-gold hover:shadow-lg transition-all flex flex-col justify-between h-full">
          <div>
            <div class="w-10 h-10 rounded-sm bg-neutral-900 text-brand-gold flex items-center justify-center font-serif font-bold text-lg mb-3">
              05
            </div>
            <h3 class="font-serif font-bold text-lg text-brand-dark leading-snug min-h-[1.75rem]" data-i18n="finish_5_title">Vacuum Metallization & Electroplating</h3>
            <p class="text-xs text-neutral-600 leading-relaxed mt-2 min-h-[3.5rem]" data-i18n="finish_5_desc">
              Flawless mirror-finish chrome and champagne gold coatings for dropper collars, push buttons, and perfume caps. Tested with 48H salt spray corrosion resistance.
            </p>
          </div>
          <span class="inline-block text-[11px] font-mono text-brand-gold-dark font-medium mt-4 pt-2 border-t border-neutral-200/60" data-i18n="finish_5_tag">Aluminum, Zamac, & UV Plastic Plating</span>
        </div>

        <div class="p-6 rounded-sm border border-neutral-200 bg-neutral-50/60 hover:bg-white hover:border-brand-gold hover:shadow-lg transition-all flex flex-col justify-between h-full">
          <div>
            <div class="w-10 h-10 rounded-sm bg-neutral-900 text-brand-gold flex items-center justify-center font-serif font-bold text-lg mb-3">
              06
            </div>
            <h3 class="font-serif font-bold text-lg text-brand-dark leading-snug min-h-[1.75rem]" data-i18n="finish_6_title">Turnkey Secondary Box Packaging</h3>
            <p class="text-xs text-neutral-600 leading-relaxed mt-2 min-h-[3.5rem]" data-i18n="finish_6_desc">
              Complete the unboxing experience. Custom rigid gift boxes, folding cartons, embossed sleeves, and EVA / paper pulp inserts custom-engineered for exact bottle fit.
            </p>
          </div>
          <span class="inline-block text-[11px] font-mono text-brand-gold-dark font-medium mt-4 pt-2 border-t border-neutral-200/60" data-i18n="finish_6_tag">One-Stop Turnkey Assembly in Guangzhou</span>
        </div>

      </div>

    </div>
  </section>

  <!-- 5. GUANGZHOU ADVANTAGE & QUALITY ASSURANCE SHIELD -->
  <section class="py-20 bg-brand-dark text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        
        <!-- Left Column: Why Guangzhou Supply Chain Wins -->
        <div class="space-y-6">
          <Badge variant="gold" size="sm">
            <span data-i18n="gz_badge">Your Eyes & Ears in China</span>
          </Badge>
          
          <h2 class="font-serif text-3xl sm:text-4xl font-bold leading-tight" data-i18n="gz_title">
            Why Global Brands Choose Our Guangzhou Supply Chain Hub
          </h2>

          <p class="text-sm text-neutral-300 leading-relaxed" data-i18n="gz_desc">
            Single-line glass factories only sell bare glass bottles with rigid 50,000 MOQs and zero customization. Located in Guangzhou—the undisputed epicenter of the world's cosmetic supply chain—we bridge this gap by delivering turnkey, matched packaging systems with Western-grade quality management.
          </p>

          <div class="space-y-4 pt-2">
            <div class="flex items-start space-x-3">
              <div class="w-6 h-6 rounded-full bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <div>
                <h3 class="text-sm font-bold text-white" data-i18n="gz_p1_title">Full-Match Turnkey Integration</h3>
                <p class="text-xs text-neutral-400" data-i18n="gz_p1_desc">Bottle + Dropper/Pump + Decoration + Secondary Box. 100% thread compatibility guaranteed with zero leaks.</p>
              </div>
            </div>

            <div class="flex items-start space-x-3">
              <div class="w-6 h-6 rounded-full bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <div>
                <h3 class="text-sm font-bold text-white" data-i18n="gz_p2_title">Rigorous Pre-Shipment Inspection (AQL 2.5)</h3>
                <p class="text-xs text-neutral-400" data-i18n="gz_p2_desc">Every production run undergoes -0.08 MPa vacuum leak testing and ISTA 3A drop testing. Comprehensive photo/video reports provided before you pay the balance.</p>
              </div>
            </div>

            <div class="flex items-start space-x-3">
              <div class="w-6 h-6 rounded-full bg-brand-gold/20 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-3.5 h-3.5 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <div>
                <h3 class="text-sm font-bold text-white" data-i18n="gz_p3_title">Flexible Trial Runs (Low MOQ 1,000 Pcs)</h3>
                <p class="text-xs text-neutral-400" data-i18n="gz_p3_desc">We support startup indie brands with low-risk batch sizes and consolidated multi-SKU sea container shipments.</p>
              </div>
