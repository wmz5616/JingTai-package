<script>
  const form = document.getElementById("sample-kit-form") as HTMLFormElement;
  const submitBtn = document.getElementById(
    "sample-submit-btn",
  ) as HTMLButtonElement;
  const feedback = document.getElementById("sample-feedback");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    const originalText = submitBtn.innerText;
    submitBtn.disabled = true;
    submitBtn.innerText =
      document.documentElement.lang === "zh"
        ? "正在提交至广州调度中心..."
        : "Transmitting to Guangzhou Logistics Desk...";

    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: "POST",
        body: formData,
        headers: { Accept: "application/json" },
      });

      const successIconSvg = '<svg class="w-4 h-4 text-emerald-600 inline-block mr-1.5 align-text-bottom flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>';
      const errorIconSvg = '<svg class="w-4 h-4 text-red-600 inline-block mr-1.5 align-text-bottom flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>';

      if (response.ok) {
        form.reset();
        if (feedback) {
          feedback.className = "text-center text-xs p-4 rounded bg-emerald-50 text-emerald-800 border border-emerald-200";
          feedback.innerHTML =
            document.documentElement.lang === "zh"
              ? `${successIconSvg}样品盒申请已成功提交！广州物流组将在 24 小时内核实收件地址并发出 DHL 寄件单号。`
              : `${successIconSvg}Sample Kit request submitted! Our logistics desk will review your address and email your DHL tracking confirmation within 24 hours.`;
          feedback.classList.remove("hidden");
        }
        submitBtn.innerText =
          document.documentElement.lang === "zh"
            ? "样品盒申请提交成功"
            : "Application Submitted Successfully";
      } else {
        if (feedback) {
          feedback.className = "text-center text-xs p-4 rounded bg-red-50 text-red-800 border border-red-200";
          feedback.innerHTML =
            document.documentElement.lang === "zh"
              ? `${errorIconSvg}申请未能送达，请直接添加微信: <strong>159 1312 8180</strong> 或拨打 <strong>+86 159 1312 8180</strong> 优先调样！`
              : `${errorIconSvg}Application could not be delivered. Please contact us directly on WhatsApp: <a href='https://wa.me/8618318105616' target='_blank' class='underline font-bold'>+86 183 1810 5616</a> or email: <a href='mailto:lih093269@gmail.com' class='underline font-bold'>lih093269@gmail.com</a>.`;
          feedback.classList.remove("hidden");
        }
        submitBtn.innerText =
          document.documentElement.lang === "zh"
            ? "提交遇到问题，请重试"
            : "Please try again or contact us";
      }
    } catch {
      const errorIconSvg = '<svg class="w-4 h-4 text-red-600 inline-block mr-1.5 align-text-bottom flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>';
      if (feedback) {
        feedback.className = "text-center text-xs p-4 rounded bg-red-50 text-red-800 border border-red-200";
        feedback.innerHTML =
          document.documentElement.lang === "zh"
            ? `${errorIconSvg}网络连接异常，请直接添加微信: <strong>159 1312 8180</strong> 或拨打 <strong>+86 159 1312 8180</strong> 优先调样！`
            : `${errorIconSvg}Network connection error. Please message our Guangzhou logistics desk on WhatsApp: <a href='https://wa.me/8618318105616' target='_blank' class='underline font-bold'>+86 183 1810 5616</a> or email: <a href='mailto:lih093269@gmail.com' class='underline font-bold'>lih093269@gmail.com</a>.`;
        feedback.classList.remove("hidden");
      }
      submitBtn.innerText =
        document.documentElement.lang === "zh"
          ? "网络异常，请重试"
          : "Network error, please retry";
    } finally {
      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.innerText = originalText;
      }, 3500);
    }
  });
</script>
