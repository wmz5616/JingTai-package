---
import Layout from '../../../layouts/Layout.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Badge from '../../../components/Badge.astro';
import products from '../../../data/products.json';
import site from '../../../data/site.json';

export function getStaticPaths() {
  return [
    { params: { lang: 'zh' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'de' } },
  ];
}

const { lang } = Astro.params;

const categories = [
  { slug: 'all', label: 'All Packaging', label_zh: '全部包装型号', label_es: 'Todos los Envases', label_fr: 'Tous les Emballages', label_de: 'Alle Verpackungen' },
  { slug: 'dropper', label: 'Dropper Bottles', label_zh: '精油滴管瓶', label_es: 'Frascos Cuentagotas', label_fr: 'Flacons Compte-gouttes', label_de: 'Tropfflaschen' },
  { slug: 'pump', label: 'Pump & Lotion', label_zh: '精华与乳液泵瓶', label_es: 'Envases con Bomba', label_fr: 'Flacons Pompes', label_de: 'Pumpflaschen' },
  { slug: 'jar', label: 'Cream & Treatment Jars', label_zh: '面霜与眼霜宽口罐', label_es: 'Tarros para Cremas', label_fr: 'Pots de Crème', label_de: 'Kosmetiktiegel' },
  { slug: 'spray', label: 'Mist Spray & Perfume', label_zh: '香水与细密喷雾瓶', label_es: 'Perfumes y Sprays', label_fr: 'Vaporisateurs', label_de: 'Parfümflakons' },
];

const getCategoryLabel = (cat: any) => {
  if (lang === 'zh') return cat.label_zh;
  if (lang === 'es') return cat.label_es || cat.label;
  if (lang === 'fr') return cat.label_fr || cat.label;
  if (lang === 'de') return cat.label_de || cat.label;
  return cat.label;
};

let pageTitle = `Cosmetic Glass Bottle Catalog | ${site.name}`;
let pageDesc = "Explore our complete line of cosmetic glass packaging: dropper bottles, treatment pump bottles, thick-wall cream pots, and perfume flacons. Low MOQ from 1,000 pcs, DDP worldwide delivery.";

if (lang === 'zh') {
  pageTitle = `化妆品玻璃瓶全系产品目录 | ${site.name}`;
  pageDesc = "浏览全系高端化妆品玻璃包装：精油滴管瓶、乳液精华泵瓶、重底面霜膏霜罐及高定香水瓶。支持1,000只低门槛起订试单，全球DDP双清到门交付。";
} else if (lang === 'es') {
  pageTitle = `Catálogo de Envases de Vidrio Cosmético | ${site.name}`;
  pageDesc = "Explore nuestra línea completa de envases cosméticos de vidrio: goteros, bombas de tratamiento, tarros y frascos de perfume. Pedido mínimo 1.000 piezas, envío DDP.";
} else if (lang === 'fr') {
  pageTitle = `Catalogue d'Emballages en Verre Cosmétique | ${site.name}`;
  pageDesc = "Découvrez notre gamme complète d'emballages cosmétiques en verre : flacons compte-gouttes, pompes de soin, pots et vaporisateurs. Faible MOQ dès 1 000 pièces, livraison DDP.";
} else if (lang === 'de') {
  pageTitle = `Katalog für Kosmetikglasverpackungen | ${site.name}`;
  pageDesc = "Entdecken Sie unser Sortiment an Kosmetikglasverpackungen: Tropfflaschen, Pumpflaschen, Cremetiegel und Parfümflakons. Geringe Mindestmenge 1.000 Stk., weltweite DDP-Lieferung.";
}
---

<Layout
  lang={lang}
  title={pageTitle}
  title_zh={`化妆品玻璃瓶全系产品目录 | ${site.name}`}
  description={pageDesc}
  description_zh="浏览全系高端化妆品玻璃包装：精油滴管瓶、乳液精华泵瓶、重底面霜膏霜罐及高定香水瓶。支持1,000只低门槛起订试单，全球DDP双清到门交付。"
>
  <!-- Page Header -->
  <section class="bg-brand-dark text-white py-16 border-b border-neutral-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-4">
        <Badge variant="gold" size="sm">
          <span data-i18n="catalog_badge">Wholesale B2B Catalog</span>
        </Badge>
        <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-white" data-i18n="catalog_title">
          Cosmetic Glass Packaging Collections
        </h1>
        <p class="text-sm sm:text-base text-neutral-300 font-light leading-relaxed" data-i18n="catalog_desc">
          Engineered for international beauty brands and clinical dermatologists. All models feature standard DIN thread finishes, negative-pressure leak resistance, and customizable surface treatments.
        </p>
      </div>
    </div>
  </section>

  <!-- Filter & Catalog Body -->
  <section class="py-12 bg-[#faf9f6]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Filter Toolbar -->
      <div class="bg-white p-4 sm:p-6 rounded-sm border border-neutral-200 shadow-sm mb-10 flex flex-col md:flex-row items-center justify-between gap-4">
        
        <!-- Category Filter Pills -->
        <div class="flex overflow-x-auto no-scrollbar sm:flex-wrap items-center gap-2 w-full md:w-auto pb-1 sm:pb-0" id="category-filter-buttons">
          {categories.map((cat) => (
            <button
              type="button"
              class="filter-btn px-4 py-2 text-xs font-semibold rounded-sm border transition-all duration-200 whitespace-nowrap flex-shrink-0"
              data-category={cat.slug}
            >
              <span data-en={cat.label} data-zh={cat.label_zh}>{getCategoryLabel(cat)}</span>
            </button>
          ))}
        </div>

        <!-- Keyword Search Input -->
        <div class="relative w-full md:w-72">
          <input
            type="text"
            id="catalog-search"
            placeholder="Search by size, material, or keyword..."
            data-i18n-placeholder="catalog_search_placeholder"
            class="w-full pl-9 pr-4 py-2 text-xs bg-neutral-50 border border-neutral-300 rounded-sm focus:ring-2 focus:ring-brand-gold focus:border-brand-gold"
          />
          <svg class="w-4 h-4 text-neutral-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
        </div>

      </div>

      <!-- Active Count & Results Notice -->
      <div class="flex items-center justify-between text-xs text-neutral-500 mb-6 px-1">
        <div>
          <span data-i18n="catalog_showing">Showing</span> <span id="visible-count" class="font-bold text-neutral-800">{products.length}</span> <span data-i18n="catalog_models">packaging models</span>
        </div>
        <div class="hidden sm:block">
          <span data-i18n="catalog_custom_mould">Need custom volume or mold?</span> <button type="button" class="quick-quote-btn text-brand-gold-dark font-semibold underline hover:text-brand-dark" data-product-title="Custom Mould Inquiry" data-i18n="catalog_inquire_bespoke">Inquire for Bespoke Tooling</button>
        </div>
      </div>

      <!-- Products Grid Container -->
      <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {products.map((product) => (
          <div
            class="product-item"
            data-category={product.categorySlug}
            data-search={`${product.name} ${product.name_zh || ''} ${product.subtitle || ''} ${product.subtitle_zh || ''} ${product.volume} ${product.specs.neckSize} ${product.category}`.toLowerCase()}
          >
            <ProductCard product={product} lang={lang} />
          </div>
        ))}
      </div>

      <!-- No Products Found State -->
      <div id="no-results-message" class="hidden py-20 text-center space-y-3 bg-white rounded border border-neutral-200">
        <p class="font-serif text-lg font-bold text-neutral-800" data-i18n="catalog_no_results">No matching packaging found</p>
        <p class="text-xs text-neutral-500" data-i18n="catalog_no_results_desc">Try adjusting your category filter or search terms, or ask our Guangzhou engineers for custom sourcing.</p>
        <button
          type="button"
          id="reset-filter-btn"
          class="px-4 py-2 bg-brand-dark text-white text-xs font-semibold rounded-sm hover:bg-neutral-800 transition-colors"
          data-i18n="catalog_reset"
        >
          Reset Filters
        </button>
      </div>

    </div>
  </section>
</Layout>

<script>
  // Filter and Search Client Script
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const items = document.querySelectorAll<HTMLElement>('.product-item');
  const searchInput = document.getElementById('catalog-search') as HTMLInputElement;
  const countText = document.getElementById('visible-count');
  const noResults = document.getElementById('no-results-message');
  const resetBtn = document.getElementById('reset-filter-btn');

  let activeCategory = 'all';
  let searchQuery = '';

  // Check URL Param for preselected category
  const urlParams = new URLSearchParams(window.location.search);
  const paramCat = urlParams.get('category');
  if (paramCat && ['dropper', 'pump', 'jar', 'spray'].includes(paramCat)) {
    activeCategory = paramCat;
  }

  function updateFilterUI() {
    buttons.forEach((btn) => {
      const cat = btn.getAttribute('data-category');
      if (cat === activeCategory) {
        btn.className = 'filter-btn px-4 py-2 text-xs font-semibold rounded-sm border bg-brand-dark text-white border-brand-dark shadow-sm transition-all duration-200';
      } else {
        btn.className = 'filter-btn px-4 py-2 text-xs font-semibold rounded-sm border bg-neutral-50 text-neutral-700 border-neutral-200 hover:bg-neutral-100 transition-all duration-200';
      }
    });

    let visibleCount = 0;
    items.forEach((item) => {
      const itemCat = item.getAttribute('data-category');
      const itemSearch = item.getAttribute('data-search') || '';

      const matchCat = activeCategory === 'all' || itemCat === activeCategory;
      const matchSearch = !searchQuery || itemSearch.includes(searchQuery);

      if (matchCat && matchSearch) {
        item.style.display = '';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    if (countText) countText.textContent = visibleCount.toString();
    if (noResults) {
      if (visibleCount === 0) {
        noResults.classList.remove('hidden');
      } else {
        noResults.classList.add('hidden');
      }
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      activeCategory = btn.getAttribute('data-category') || 'all';
      updateFilterUI();
    });
  });

  searchInput?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    updateFilterUI();
  });

  resetBtn?.addEventListener('click', () => {
    activeCategory = 'all';
    searchQuery = '';
    if (searchInput) searchInput.value = '';
    updateFilterUI();
  });

  // Initial Run
  updateFilterUI();
</script>
