---
import Layout from '../../../layouts/Layout.astro';
import Badge from '../../../components/Badge.astro';
import ProductCard from '../../../components/ProductCard.astro';
import products from '../../../data/products.json';
import site from '../../../data/site.json';
import translationsData from '../../../i18n/translations.json';
import { getAssetUrl } from '../../../utils/assets';

export async function getStaticPaths() {
  const langs = ['zh', 'es', 'fr', 'de'];
  return langs.flatMap((lang) =>
    products.map((product) => ({
      params: { lang, id: product.id },
      props: { product, lang },
    }))
  );
}

const { product, lang } = Astro.props;
const fallbackImg = 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=1200&q=80';
const resolvedImages = (product.images || []).map((img) => getAssetUrl(img));

// Related products
const relatedProducts = products
  .filter((p) => p.categorySlug === product.categorySlug && p.id !== product.id)
  .slice(0, 3);

// Product Schema.org JSON-LD
const productSchema = {
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: lang === 'zh' ? (product.name_zh || product.name) : product.name,
  image: resolvedImages,
  description: lang === 'zh' ? (product.description_zh || product.description) : product.description,
  sku: product.id,
  mpn: product.id,
  brand: {
    '@type': 'Brand',
    name: site.name,
  },
  category: lang === 'zh' ? (product.category_zh || product.category) : product.category,
  offers: {
    '@type': 'AggregateOffer',
    priceCurrency: 'USD',
    lowPrice: '0.25',
    highPrice: '1.45',
    priceValidUntil: '2027-12-31',
    offerCount: '100000',
    itemCondition: 'https://schema.org/NewCondition',
    availability: 'https://schema.org/InStock',
    eligibleQuantity: {
      '@type': 'QuantitativeValue',
      minValue: product.moq,
      unitCode: 'C62',
    },
  },
};

// Language-specific localized titles
let pageTitle = `${product.name} Wholesale | ${site.name}`;
let pageDesc = `${product.name} wholesale supply by ${site.name}. ${product.description} MOQ: ${product.moq} pcs. Fast DDP delivery from Guangzhou.`;

if (lang === 'zh') {
  pageTitle = `${product.name_zh || product.name} 工厂批发采购 | ${site.name}`;
  pageDesc = `${product.name_zh || product.name} 广州源头工厂直供。${product.description_zh || product.description} 起订量：${product.moq} 只。支持欧美全球 DDP 门到门送达。`;
} else if (lang === 'es') {
  pageTitle = `${product.name} al por Mayor | ${site.name}`;
  pageDesc = `Suministro al por mayor de ${product.name} de ${site.name}. Pedido mínimo: ${product.moq} piezas. Envío DDP puerta a puerta desde Guangzhou.`;
} else if (lang === 'fr') {
  pageTitle = `${product.name} Vente en Gros | ${site.name}`;
  pageDesc = `Fourniture en gros de ${product.name} par ${site.name}. Commande minimum: ${product.moq} pièces. Livraison DDP depuis Guangzhou.`;
} else if (lang === 'de') {
  pageTitle = `${product.name} Großhandel | ${site.name}`;
  pageDesc = `Großhandel für ${product.name} von ${site.name}. Mindestbestellmenge: ${product.moq} Stück. Zuverlässige DDP-Lieferung ab Guangzhou.`;
}
---

<Layout
  lang={lang}
  title={pageTitle}
  title_zh={`${product.name_zh || product.name} 工厂批发采购 | ${site.name}`}
  description={pageDesc}
  description_zh={`${product.name_zh || product.name} 广州源头工厂直供。${product.description_zh || product.description} 起订量：${product.moq} 只。支持欧美全球 DDP 门到门送达。`}
  image={resolvedImages[0]}
  type="product"
  schemaJson={productSchema}
>
  <!-- Breadcrumb Navigation -->
  <nav class="bg-white border-b border-neutral-200 py-3 text-xs text-neutral-500">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center space-x-2">
      <a href={`/${lang}`} class="hover:text-brand-dark" data-i18n="prod_breadcrumb_home">Home</a>
      <span>/</span>
      <a href={`/${lang}/products`} class="hover:text-brand-dark" data-i18n="prod_breadcrumb_products">Products</a>
      <span>/</span>
      <a href={`/${lang}/products?category=${product.categorySlug}`} class="hover:text-brand-dark">
        <span data-en={product.category} data-zh={product.category_zh || product.category}>{lang === 'zh' ? (product.category_zh || product.category) : product.category}</span>
      </a>
      <span>/</span>
      <span class="text-neutral-900 font-medium truncate max-w-xs" data-en={product.name} data-zh={product.name_zh || product.name}>
        {lang === 'zh' ? (product.name_zh || product.name) : product.name}
      </span>
    </div>
  </nav>

  <!-- Product Main Showcase Section -->
  <section class="py-12 sm:py-16 bg-[#faf9f6]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Image Gallery (Col 6) -->
        <div class="lg:col-span-6 space-y-4">
          <!-- Main Hero Image Container -->
          <div class="relative aspect-square w-full bg-white rounded-sm border border-neutral-200 overflow-hidden shadow-sm">
            <img
              id="main-product-image"
              src={resolvedImages[0] || fallbackImg}
              alt={product.name}
              onerror={`this.onerror=null; this.src='${fallbackImg}';`}
              class="w-full h-full object-cover object-center transition-all duration-300"
            />
            
            <div class="absolute top-4 left-4 flex flex-col gap-2 pointer-events-none">
              {product.badge && (
                <Badge variant="gold" size="sm">
                  <span data-en={product.badge} data-zh={product.badge_zh || product.badge}>{lang === 'zh' ? (product.badge_zh || product.badge) : product.badge}</span>
                </Badge>
              )}
              <Badge variant="light" size="sm">
                <span data-en={product.volume} data-zh={product.volume_zh || product.volume}>{lang === 'zh' ? (product.volume_zh || product.volume) : product.volume}</span>
              </Badge>
            </div>
          </div>

          <!-- Thumbnails Selector -->
          {resolvedImages.length > 1 && (
            <div class="grid grid-cols-4 gap-3">
              {resolvedImages.map((img, idx) => (
                <button
                  type="button"
                  class={`gallery-thumb aspect-square bg-white rounded-sm border-2 overflow-hidden transition-all ${idx === 0 ? 'border-brand-gold ring-2 ring-brand-gold/30' : 'border-neutral-200 hover:border-neutral-400'}`}
                  data-src={img}
                >
                  <img
                    src={img}
                    alt={`View ${idx + 1}`}
                    onerror={`this.onerror=null; this.src='${fallbackImg}';`}
                    class="w-full h-full object-cover"
                  />
                </button>
              ))}
            </div>
          )}

          <!-- Quick Action Buttons: QA Specs & RFQ Basket -->
          <div class="pt-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
            <button
              type="button"
              class="add-to-rfq-btn py-3 px-4 bg-brand-dark hover:bg-neutral-800 text-white font-semibold text-xs rounded-sm transition-colors flex items-center justify-center space-x-2 shadow-sm"
              data-id={product.id}
              data-name={product.name}
              data-name-zh={product.name_zh || product.name}
              data-volume={product.volume}
              data-image={product.images[0] || fallbackImg}
              data-moq={product.moq}
            >
              <svg class="w-4 h-4 text-brand-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
              <span data-i18n="card_add_to_rfq">Add to RFQ Basket</span>
            </button>

            <a
              href={`/${lang}/sample-kit`}
              class="py-3 px-4 bg-white hover:bg-amber-50 text-amber-900 border border-amber-300 font-semibold text-xs rounded-sm transition-colors flex items-center justify-center space-x-1.5 shadow-sm text-center"
            >
              <span data-i18n="prod_sample_box_btn">Request Free Sample Box</span>
              <span class="text-[10px] bg-amber-200 px-1 py-0.2 rounded font-bold" data-i18n="nav_free_badge">FREE</span>
            </a>
          </div>

          <!-- AQL 2.5 Leak QA Notice -->
          <div class="p-3.5 sm:p-4 bg-white border border-neutral-200 rounded-sm flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs">
            <div class="flex items-center space-x-3">
              <div class="w-8 h-8 rounded bg-emerald-50 text-emerald-700 flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <div>
                <strong class="text-neutral-900 block font-sans" data-i18n="prod_qa_title">AQL 2.5 Vacuum Leak QA Guarantee</strong>
                <span class="text-neutral-500" data-i18n="prod_qa_desc">100% thread torque verified with -0.08 MPa depressurization testing before shipment.</span>
              </div>
            </div>
            <button
              type="button"
              class="quick-quote-btn text-brand-gold-dark font-semibold hover:underline flex-shrink-0 self-end sm:self-auto"
              data-product-title={`QA Report Request: ${product.name}`}
              data-i18n="prod_request_qa"
            >
              Request QA Specs →
            </button>
          </div>
        </div>

        <!-- Right: Technical Details & Inquiry Form (Col 6) -->
        <div class="lg:col-span-6 space-y-6">
          
          <div class="space-y-2">
            <div class="flex items-center space-x-3 text-xs font-mono uppercase tracking-wider text-neutral-500">
              <span class="text-brand-gold font-semibold" data-en={product.category} data-zh={product.category_zh || product.category}>
                {lang === 'zh' ? (product.category_zh || product.category) : product.category}
              </span>
              <span>•</span>
              <span>SKU: {product.id}</span>
            </div>

            <h1 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-bold text-brand-dark leading-tight" data-en={product.name} data-zh={product.name_zh || product.name}>
              {lang === 'zh' ? (product.name_zh || product.name) : product.name}
            </h1>

            {product.subtitle && (
              <p class="text-sm text-neutral-600 font-medium" data-en={product.subtitle} data-zh={product.subtitle_zh || product.subtitle}>
                {lang === 'zh' ? (product.subtitle_zh || product.subtitle) : product.subtitle}
              </p>
            )}
          </div>

          <!-- Value Pill Highlights -->
          <div class="flex flex-wrap gap-2 text-xs">
            <span class="inline-flex items-center space-x-1 px-3 py-1 bg-emerald-50 text-emerald-800 border border-emerald-200 rounded font-medium">
              <svg class="w-3.5 h-3.5 text-emerald-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              <span><span data-i18n="prod_moq_stock">In-Stock Trial MOQ:</span> {product.inStockMoq || 1000} pcs</span>
            </span>
            <span class="inline-flex items-center space-x-1 px-3 py-1 bg-neutral-100 text-neutral-700 border border-neutral-200 rounded font-medium">
              <svg class="w-3.5 h-3.5 text-neutral-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              <span><span data-i18n="prod_moq_custom">Custom Run MOQ:</span> {product.moq} pcs</span>
            </span>
            <span class="inline-flex items-center space-x-1 px-3 py-1 bg-neutral-100 text-neutral-700 border border-neutral-200 rounded font-medium">
              <svg class="w-3.5 h-3.5 text-neutral-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              <span><span data-i18n="prod_lead_time_label">Lead Time:</span> <span data-en={product.leadTime} data-zh={product.leadTime_zh || product.leadTime}>{lang === 'zh' ? (product.leadTime_zh || product.leadTime) : product.leadTime}</span></span>
            </span>
          </div>

          <!-- Product Detailed Description -->
          <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed" data-en={product.description} data-zh={product.description_zh || product.description}>
            {lang === 'zh' ? (product.description_zh || product.description) : product.description}
          </p>

          <!-- Core Feature Bullets -->
          <div class="p-4 bg-white rounded-sm border border-neutral-200 space-y-2">
            <span class="block text-xs font-mono font-bold text-brand-dark uppercase tracking-wider" data-i18n="prod_eng_highlights">
              Engineering & Performance Highlights:
            </span>
            <ul class="space-y-1.5 text-xs text-neutral-600">
              {(product.features_zh || product.features)?.map((feat, i) => (
                <li class="flex items-start space-x-2">
                  <svg class="w-3.5 h-3.5 text-brand-gold flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                  <span data-en={product.features?.[i] || feat} data-zh={product.features_zh?.[i] || feat}>
                    {lang === 'zh' ? (product.features_zh?.[i] || feat) : (product.features?.[i] || feat)}
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Complete Technical Specification Table -->
          <div class="space-y-2">
            <h2 class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-800" data-i18n="prod_eng_specs">
              Engineering Specifications
            </h2>
            <div class="bg-white rounded-sm border border-neutral-200 overflow-x-auto text-xs">
              <table class="w-full text-left border-collapse">
                <tbody>
                  <tr class="border-b border-neutral-100">
                    <th class="py-2.5 px-3 sm:px-4 font-mono font-semibold text-neutral-500 bg-neutral-50/70 w-32 sm:w-48 whitespace-normal sm:whitespace-nowrap" data-i18n="prod_spec_neck">Neck Thread Standard</th>
                    <td class="py-2.5 px-3 sm:px-4 font-medium text-neutral-900 break-words">{product.specs.neckSize}</td>
                  </tr>
                  <tr class="border-b border-neutral-100">
                    <th class="py-2.5 px-3 sm:px-4 font-mono font-semibold text-neutral-500 bg-neutral-50/70 w-32 sm:w-48 whitespace-normal sm:whitespace-nowrap" data-i18n="prod_spec_material">Glass Material</th>
                    <td class="py-2.5 px-3 sm:px-4 font-medium text-neutral-900 break-words">{product.specs.material}</td>
                  </tr>
                  <tr class="border-b border-neutral-100">
                    <th class="py-2.5 px-3 sm:px-4 font-mono font-semibold text-neutral-500 bg-neutral-50/70 w-32 sm:w-48 whitespace-normal sm:whitespace-nowrap" data-i18n="prod_spec_dimensions">Total Height & Diameter</th>
                    <td class="py-2.5 px-3 sm:px-4 font-medium text-neutral-900 break-words">{product.specs.height} × {product.specs.diameter}</td>
                  </tr>
                  <tr class="border-b border-neutral-100">
                    <th class="py-2.5 px-3 sm:px-4 font-mono font-semibold text-neutral-500 bg-neutral-50/70 w-32 sm:w-48 whitespace-normal sm:whitespace-nowrap" data-i18n="prod_spec_weight">Empty Container Weight</th>
                    <td class="py-2.5 px-3 sm:px-4 font-medium text-neutral-900 break-words">{product.specs.weight}</td>
                  </tr>
                  <tr class="border-b border-neutral-100">
                    <th class="py-2.5 px-3 sm:px-4 font-mono font-semibold text-neutral-500 bg-neutral-50/70 w-32 sm:w-48 whitespace-normal sm:whitespace-nowrap" data-i18n="prod_spec_capacity">Brimful Capacity</th>
                    <td class="py-2.5 px-3 sm:px-4 font-medium text-neutral-900 break-words">{product.specs.brimfulCapacity}</td>
                  </tr>
                  <tr class="border-b border-neutral-100">
                    <th class="py-2.5 px-3 sm:px-4 font-mono font-semibold text-neutral-500 bg-neutral-50/70 w-32 sm:w-48 whitespace-normal sm:whitespace-nowrap" data-i18n="prod_spec_closures">Compatible Closures</th>
                    <td class="py-2.5 px-3 sm:px-4 font-medium text-neutral-900 break-words">{product.specs.closureTypes?.join(', ')}</td>
                  </tr>
                  <tr>
                    <th class="py-2.5 px-3 sm:px-4 font-mono font-semibold text-neutral-500 bg-neutral-50/70 w-32 sm:w-48 whitespace-normal sm:whitespace-nowrap" data-i18n="prod_spec_surfaces">Surface Options</th>
                    <td class="py-2.5 px-3 sm:px-4 font-medium text-neutral-900 break-words">{product.specs.surfaceHandling?.join(', ')}</td>
                  </tr>
                </tbody>
              </table>
            </div>
          </div>

          <!-- Direct Quotation Trigger Card -->
          <div class="p-4 sm:p-6 bg-brand-dark text-white rounded-sm space-y-4 shadow-lg border border-neutral-800">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs font-mono text-brand-gold uppercase" data-i18n="prod_direct_quote_tag">Direct Factory Quotation</span>
                <h3 class="font-serif text-lg font-bold text-white" data-i18n="prod_direct_quote_title">Get Volume Pricing for This Model</h3>
              </div>
              <span class="text-xs text-neutral-400" data-i18n="nav_guangzhou_hub">Guangzhou Hub</span>
            </div>
            <p class="text-xs text-neutral-300" data-i18n="prod_direct_quote_desc">
              Tell us your estimated quantity and target shipping country. Receive official price quotation and DDP air/sea freight breakdown within 2-4 hours.
            </p>
            <div class="flex flex-col sm:flex-row gap-3 pt-1">
              <button
                type="button"
                class="quick-quote-btn flex-1 py-3 bg-brand-gold hover:bg-brand-gold-light text-brand-dark font-bold text-xs rounded-sm tracking-wide transition-colors"
                data-product-title={product.name}
                data-product-id={product.id}
                data-i18n="prod_quote_btn"
              >
                Request Wholesale Quote Now →
              </button>
              <!-- WeChat in Chinese mode -->
              <button
                type="button"
                data-open-wechat
                class="contact-lang-zh py-3 px-4 bg-[#07C160] hover:bg-[#06ad56] text-white font-semibold text-xs rounded-sm flex items-center justify-center space-x-1.5 transition-colors cursor-pointer"
              >
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
                  <path d="M8.691 2.188C3.891 2.188 0 5.478 0 9.532c0 2.212 1.157 4.205 2.972 5.568l-.75 2.748 3.19-1.636c1.02.28 2.12.44 3.279.44.204 0 .405-.008.607-.021-.24-.707-.373-1.464-.373-2.253 0-4.054 3.891-7.344 8.691-7.344.296 0 .588.014.877.038C17.336 4.795 13.34 2.188 8.691 2.188zm-2.316 4.148c.677 0 1.226.549 1.226 1.226s-.549 1.226-1.226 1.226c-.676 0-1.225-.549-1.225-1.226s.549-1.226 1.225-1.226zm5.18 0c.677 0 1.226.549 1.226 1.226s-.549 1.226-1.226 1.226c-.677 0-1.226-.549-1.226-1.226s.549-1.226 1.226-1.226zm5.94 4.544c-4.106 0-7.435 2.82-7.435 6.297 0 3.478 3.329 6.297 7.435 6.297.915 0 1.792-.137 2.607-.386l2.454 1.258-.577-2.113c1.558-1.047 2.548-2.58 2.548-4.301 0-3.477-3.329-6.297-7.432-6.297zm-2.316 3.555c.58 0 1.05.47 1.05 1.051 0 .58-.47 1.05-1.05 1.05-.581 0-1.051-.47-1.051-1.05 0-.581.47-1.051 1.051-1.051zm4.436 0c.58 0 1.051.47 1.051 1.051 0 .58-.471 1.05-1.051 1.05-.58 0-1.05-.47-1.05-1.05 0-.581.47-1.051 1.05-1.051z"/>
                </svg>
                <span>微信咨询 / 索样</span>
              </button>

              <!-- WhatsApp in English mode -->
              <a
                href={site.whatsappDirectUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="contact-lang-en py-3 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-semibold text-xs rounded-sm flex items-center justify-center space-x-1.5 transition-colors"
              >
                <span data-i18n="prod_whatsapp_btn">WhatsApp Us</span>
              </a>
            </div>
          </div>

        </div>

      </div>
    </div>
  </section>

  <!-- Related Packaging Models -->
  {relatedProducts.length > 0 && (
    <section class="py-16 bg-white border-t border-neutral-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between mb-8">
          <div>
            <span class="text-xs font-mono text-brand-gold uppercase" data-i18n="prod_rel_tag">Explore Alternatives</span>
            <h2 class="font-serif text-2xl font-bold text-brand-dark mt-1" data-i18n="prod_rel_title">
              Related Packaging Models
            </h2>
          </div>
          <a href={`/${lang}/products`} class="text-xs font-semibold text-neutral-600 hover:text-brand-dark" data-i18n="prod_view_all">
            View All →
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {relatedProducts.map((rel) => (
            <ProductCard product={rel} lang={lang} />
          ))}
        </div>
      </div>
    </section>
  )}
</Layout>

<script>
  // Image gallery switcher
  const mainImage = document.getElementById('main-product-image') as HTMLImageElement;
  const thumbnails = document.querySelectorAll('.gallery-thumb');

  thumbnails.forEach((thumb) => {
    thumb.addEventListener('click', () => {
      const newSrc = thumb.getAttribute('data-src');
      if (newSrc && mainImage) {
        mainImage.src = newSrc;
        thumbnails.forEach((t) => {
          t.className = 'gallery-thumb aspect-square bg-white rounded-sm border-2 overflow-hidden transition-all border-neutral-200 hover:border-neutral-400';
        });
        thumb.className = 'gallery-thumb aspect-square bg-white rounded-sm border-2 overflow-hidden transition-all border-brand-gold ring-2 ring-brand-gold/30';
      }
    });
  });
</script>
