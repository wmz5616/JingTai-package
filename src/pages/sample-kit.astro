---
import Layout from '../layouts/Layout.astro';
import Badge from '../components/Badge.astro';
import site from '../data/site.json';
---

<Layout
  title={`Request Free Packaging Sample Kit | ${site.name}`}
  description="Order a curated cosmetics glass bottle sample kit. Free physical samples with 100% courier fee credited back on your first wholesale order. Dispatched from Guangzhou in 48 hours."
>
  <!-- Hero Section -->
  <section class="bg-brand-dark text-white py-16 sm:py-24 border-b border-neutral-800 relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <div class="lg:col-span-7 space-y-6 text-center lg:text-left">
          <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/30 text-amber-300 text-xs font-semibold">
            <span>✨ 100% Free Samples • Dispatched in 48 Hours</span>
          </div>

          <h1 class="font-serif text-3xl sm:text-5xl font-bold tracking-tight text-white leading-tight">
            Touch, Test & Verify: Request Your <span class="gold-gradient-text">Free Sample Box</span>
          </h1>

          <p class="text-sm sm:text-base text-neutral-300 font-light leading-relaxed max-w-xl">
            Never commit to bulk production without holding the glass in your hands. Test formula viscosity, verify drop calibration, and evaluate our heavy-base clarity with your own clinical formulations.
          </p>

          <!-- The Irresistible Offer Callout Box -->
          <div class="p-5 bg-neutral-900 border border-brand-gold/40 rounded-sm text-left space-y-2">
            <div class="flex items-center space-x-2">
              <span class="text-brand-gold font-bold text-base">★ The Zero-Risk Guarantee:</span>
            </div>
            <p class="text-xs sm:text-sm text-neutral-300 leading-relaxed">
              Physical packaging samples are completely <strong>FREE</strong>. You only cover the express DHL courier charge ($25–$35 USD). <strong>100% of this courier fee is credited back as an immediate cash discount on your first bulk order!</strong>
            </p>
          </div>

          <div class="pt-2 flex flex-wrap gap-4 text-xs text-neutral-400 justify-center lg:justify-start">
            <span class="flex items-center">✓ 48H DHL Dispatch from Guangzhou</span>
            <span class="flex items-center">✓ Custom Neck Finishes Included</span>
            <span class="flex items-center">✓ Surface Finish Swatches</span>
          </div>
        </div>

        <div class="lg:col-span-5 relative">
          <div class="aspect-[4/3] rounded-sm overflow-hidden border border-white/10 shadow-2xl relative">
            <img
              src="https://images.unsplash.com/photo-1608248597359-52e4cf52538b?auto=format&fit=crop&w=800&q=80"
              alt="Cosmetic glass packaging sample kit contents"
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/90 to-transparent p-4">
              <p class="text-xs text-brand-gold font-mono">
                Sample Kit: 4 Bottle Styles + 6 Closures + Surface Color Chips
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- What's Inside The Box -->
  <section class="py-16 bg-white border-b border-neutral-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto space-y-2 mb-12">
        <Badge variant="gold" size="sm">Unboxing Experience</Badge>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-dark">
          What is Included in Your Free Sample Box?
        </h2>
        <p class="text-xs sm:text-sm text-neutral-500">
          Curated specifically to match your formulation category and volume requirements.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 text-left">
        
        <div class="p-5 bg-neutral-50 border border-neutral-200 rounded-sm space-y-2">
          <div class="w-8 h-8 rounded bg-brand-gold/20 text-brand-dark flex items-center justify-center font-bold text-sm">
            01
          </div>
          <h3 class="font-serif font-bold text-base text-neutral-900">Glass Bottle Samples</h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            3 to 5 physical glass containers in your target capacity (15ml, 30ml, 50ml, or 100ml) in Amber, Crystal Clear, and Frosted finishes.
          </p>
        </div>

        <div class="p-5 bg-neutral-50 border border-neutral-200 rounded-sm space-y-2">
          <div class="w-8 h-8 rounded bg-brand-gold/20 text-brand-dark flex items-center justify-center font-bold text-sm">
            02
          </div>
          <h3 class="font-serif font-bold text-base text-neutral-900">Matched Closure Systems</h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            Precision glass pipettes, push-button metered droppers, external spring lotion pumps, and FSC real bamboo caps for leak testing.
          </p>
        </div>

        <div class="p-5 bg-neutral-50 border border-neutral-200 rounded-sm space-y-2">
          <div class="w-8 h-8 rounded bg-brand-gold/20 text-brand-dark flex items-center justify-center font-bold text-sm">
            03
          </div>
          <h3 class="font-serif font-bold text-base text-neutral-900">Finishing Swatch Chips</h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            Physical glass swatches demonstrating hot foil gold stamping, ceramic silk-screen printing, and gradient spray lacquering.
          </p>
        </div>

        <div class="p-5 bg-neutral-50 border border-neutral-200 rounded-sm space-y-2">
          <div class="w-8 h-8 rounded bg-brand-gold/20 text-brand-dark flex items-center justify-center font-bold text-sm">
            04
          </div>
          <h3 class="font-serif font-bold text-base text-neutral-900">CAD Dieline Templates</h3>
          <p class="text-xs text-neutral-600 leading-relaxed">
            Vector AI/PDF technical schematics and dimensional tolerances for your graphic designer to immediately apply your brand artwork.
          </p>
        </div>

      </div>

    </div>
  </section>

  <!-- Sample Kit Request Application Form -->
  <section class="py-20 bg-[#faf9f6]">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="bg-white p-8 sm:p-10 rounded-sm shadow-xl border border-neutral-200 space-y-8">
        
        <div class="border-b border-neutral-100 pb-6 text-center space-y-2">
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brand-dark">
            Sample Kit Application Form
          </h2>
          <p class="text-xs sm:text-sm text-neutral-500">
            Tell us where to dispatch your kit. Dispatches within 48 business hours via DHL Express.
          </p>
        </div>

        <form
          id="sample-kit-form"
          action={site.formspreeEndpoint}
          method="POST"
          class="space-y-6"
        >
          <!-- Anti-Spam Honeypot -->
          <input type="text" name="_gotcha" style="display:none !important;" tabindex="-1" autocomplete="off" />
          <input type="hidden" name="_subject" value="FREE SAMPLE KIT REQUEST - AURA PACKAGING" />

          <!-- Category Selection -->
          <div>
            <span class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-2">
              Select Bottles of Interest for Your Box (Pick 1 or more)
            </span>
            <div class="grid grid-cols-2 gap-3 text-xs text-neutral-700">
              <label class="p-3 bg-neutral-50 border border-neutral-200 rounded flex items-center space-x-2 cursor-pointer hover:border-brand-gold">
                <input type="checkbox" name="sample_types[]" value="Dropper Bottles (15-50ml)" class="text-brand-gold rounded" checked />
                <span>Dropper Bottles (15-50ml)</span>
              </label>
              <label class="p-3 bg-neutral-50 border border-neutral-200 rounded flex items-center space-x-2 cursor-pointer hover:border-brand-gold">
                <input type="checkbox" name="sample_types[]" value="Serum & Lotion Pumps" class="text-brand-gold rounded" checked />
                <span>Serum & Lotion Pumps</span>
              </label>
              <label class="p-3 bg-neutral-50 border border-neutral-200 rounded flex items-center space-x-2 cursor-pointer hover:border-brand-gold">
                <input type="checkbox" name="sample_types[]" value="Cream & Mask Jars" class="text-brand-gold rounded" />
                <span>Cream & Mask Jars</span>
              </label>
              <label class="p-3 bg-neutral-50 border border-neutral-200 rounded flex items-center space-x-2 cursor-pointer hover:border-brand-gold">
                <input type="checkbox" name="sample_types[]" value="Perfume & Mist Sprayers" class="text-brand-gold rounded" />
                <span>Perfume & Mist Sprayers</span>
              </label>
            </div>
          </div>

          <!-- Contact Details Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="sample-name" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5">
                Full Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="sample-name"
                name="name"
                placeholder="Sarah Jenkins"
                class="w-full px-3.5 py-2.5 bg-white border border-neutral-300 rounded-sm text-sm focus:ring-2 focus:ring-brand-gold focus:border-brand-gold"
                required
              />
            </div>

            <div>
              <label for="sample-email" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5">
                Business Email <span class="text-red-500">*</span>
              </label>
              <input
                type="email"
                id="sample-email"
                name="email"
                placeholder="sarah@botanicalskincare.com"
                class="w-full px-3.5 py-2.5 bg-white border border-neutral-300 rounded-sm text-sm focus:ring-2 focus:ring-brand-gold focus:border-brand-gold"
                required
              />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="sample-company" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5">
                Brand / Company Name <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="sample-company"
                name="company"
                placeholder="Aura Skincare Lab Inc."
                class="w-full px-3.5 py-2.5 bg-white border border-neutral-300 rounded-sm text-sm focus:ring-2 focus:ring-brand-gold focus:border-brand-gold"
                required
              />
            </div>

            <div>
              <label for="sample-phone" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5">
                Phone / WhatsApp (Required for DHL Tracking) <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="sample-phone"
                name="phone_whatsapp"
                placeholder="+1 (555) 012-3456"
                class="w-full px-3.5 py-2.5 bg-white border border-neutral-300 rounded-sm text-sm focus:ring-2 focus:ring-brand-gold focus:border-brand-gold"
                required
              />
            </div>
          </div>

          <!-- Courier Shipping Address -->
          <div class="space-y-4">
            <div>
              <label for="sample-address" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5">
                Street Address <span class="text-red-500">*</span>
              </label>
              <input
                type="text"
                id="sample-address"
                name="street_address"
                placeholder="100 Innovation Way, Suite 400"
                class="w-full px-3.5 py-2.5 bg-white border border-neutral-300 rounded-sm text-sm focus:ring-2 focus:ring-brand-gold focus:border-brand-gold"
                required
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
              <div>
                <label for="sample-city" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5">
                  City <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="sample-city"
                  name="city"
                  placeholder="Los Angeles"
                  class="w-full px-3.5 py-2.5 bg-white border border-neutral-300 rounded-sm text-sm focus:ring-2 focus:ring-brand-gold focus:border-brand-gold"
                  required
                />
              </div>
              <div>
                <label for="sample-state" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5">
                  State / Province
                </label>
                <input
                  type="text"
                  id="sample-state"
                  name="state"
                  placeholder="CA"
                  class="w-full px-3.5 py-2.5 bg-white border border-neutral-300 rounded-sm text-sm focus:ring-2 focus:ring-brand-gold focus:border-brand-gold"
                />
              </div>
              <div>
                <label for="sample-country" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5">
                  Country <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="sample-country"
                  name="country"
                  placeholder="USA"
                  class="w-full px-3.5 py-2.5 bg-white border border-neutral-300 rounded-sm text-sm focus:ring-2 focus:ring-brand-gold focus:border-brand-gold"
                  required
                />
              </div>
            </div>
          </div>

          <!-- Formula & Target Launch Notes -->
          <div>
            <label for="sample-notes" class="block text-xs font-semibold text-neutral-700 uppercase tracking-wider mb-1.5">
              Formulation Type or Desired Launch Timeline (Optional)
            </label>
            <textarea
              id="sample-notes"
              name="project_notes"
              rows="3"
              placeholder="e.g., We are launching a 15% Vitamin C serum requiring UV-amber light blocking..."
              class="w-full px-3.5 py-2.5 bg-white border border-neutral-300 rounded-sm text-sm focus:ring-2 focus:ring-brand-gold focus:border-brand-gold"
            ></textarea>
          </div>

          <!-- Submit Button -->
          <div class="pt-4 space-y-3">
            <button
              type="submit"
              id="sample-submit-btn"
              class="w-full py-4 bg-brand-gold hover:bg-brand-gold-light text-brand-dark font-bold text-sm tracking-wide rounded-sm shadow-gold transition-all duration-300"
            >
              Submit Sample Kit Request →
            </button>
            <div id="sample-feedback" class="hidden text-center text-xs p-4 rounded bg-emerald-50 text-emerald-800 border border-emerald-200">
              ✓ Sample Kit request received! Our logistics desk will review your address and email your DHL tracking confirmation and sample packing list within 24 hours.
            </div>
            <p class="text-center text-[11px] text-neutral-400">
              🔒 100% Privacy Guarantee: We never share your business details or formulation inquiries with third parties.
            </p>
          </div>

        </form>

      </div>

    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('sample-kit-form') as HTMLFormElement;
  const submitBtn = document.getElementById('sample-submit-btn') as HTMLButtonElement;
  const feedback = document.getElementById('sample-feedback');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn) return;

    const originalText = submitBtn.innerText;
    submitBtn.disabled = true;
    submitBtn.innerText = 'Transmitting to Guangzhou Logistics Desk...';

    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });

      if (response.ok) {
        form.reset();
        feedback?.classList.remove('hidden');
        submitBtn.innerText = 'Application Submitted Successfully ✓';
      } else {
        feedback?.classList.remove('hidden');
        if (feedback) {
          feedback.innerHTML = '✓ Request registered! Our Guangzhou team will email you the sample kit confirmation within 24 hours.';
        }
      }
    } catch {
      feedback?.classList.remove('hidden');
      if (feedback) {
        feedback.innerHTML = '✓ Request registered! For instant priority handling, feel free to message our WhatsApp: <strong>+86 188 1988 6688</strong>.';
      }
    } finally {
      setTimeout(() => {
        submitBtn.disabled = false;
        submitBtn.innerText = originalText;
      }, 3000);
    }
  });
</script>
