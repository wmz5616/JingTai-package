---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import QuoteModal from '../components/QuoteModal.astro';
import InquiryDrawer from '../components/InquiryDrawer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import WeChatModal from '../components/WeChatModal.astro';
import site from '../data/site.json';
import { getAssetUrl } from '../utils/assets';
import '../styles/global.css';

interface Props {
  title?: string;
  title_zh?: string;
  description?: string;
  description_zh?: string;
  keywords?: string;
  image?: string;
  type?: 'website' | 'product' | 'article';
  schemaJson?: any;
  lang?: string;
}

const {
  title = `${site.name} | Luxury Cosmetic Glass Packaging & Turnkey Supply Chain`,
  title_zh = `${site.name} | 广州高端美妆玻璃瓶包材源头全案供应链`,
  description = site.description,
  description_zh = site.description_zh || site.description,
  keywords = '化妆品玻璃瓶, 精油滴管瓶批发, 广州包材工厂, 护肤品包材定制, DDP双清包税, 面霜玻璃罐, cosmetic glass packaging wholesale',
  image = 'https://images.unsplash.com/photo-1620916566398-39f1143ab7be?auto=format&fit=crop&w=1200&q=80',
  type = 'website',
  schemaJson,
  lang = 'en',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, site.url);

// Path calculation for SEO hreflangs
const pathname = Astro.url.pathname;
const cleanPath = pathname.replace(/^\/(zh|es|fr|de)(\/|$)/, '$2') || '/';
const normalizedCleanPath = cleanPath.startsWith('/') ? cleanPath : `/${cleanPath}`;

const getLangUrl = (locale: string) => {
  if (locale === 'en') {
    return `${site.url}${normalizedCleanPath}`;
  }
  const suffix = normalizedCleanPath === '/' ? '' : normalizedCleanPath;
  return `${site.url}/${locale}${suffix}`;
};

const effectiveTitle = lang === 'zh' ? title_zh : title;
const effectiveDescription = lang === 'zh' ? description_zh : description;

// Global Organization Schema
const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.companyName,
  alternateName: site.name,
  url: site.url,
  logo: getAssetUrl(site.assets?.logo || '/images/logo.png'),
  description: site.description,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Guangzhou',
    addressRegion: 'Guangdong',
    addressCountry: 'CN',
  },
  contactPoint: {
    '@type': 'ContactPoint',
    telephone: site.whatsapp,
    email: site.email,
    contactType: 'Customer Support & B2B Sales',
    availableLanguage: ['English', 'Chinese', 'Spanish', 'French', 'German'],
  },
};
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google Multi-Language Alternates (hreflang for SEO) -->
    <link rel="alternate" hreflang="x-default" href={getLangUrl('en')} />
    <link rel="alternate" hreflang="en" href={getLangUrl('en')} />
    <link rel="alternate" hreflang="zh" href={getLangUrl('zh')} />
    <link rel="alternate" hreflang="es" href={getLangUrl('es')} />
    <link rel="alternate" hreflang="fr" href={getLangUrl('fr')} />
    <link rel="alternate" hreflang="de" href={getLangUrl('de')} />

    <!-- Dual Language Meta Tags for Instant Switching -->
    <meta name="title-en" content={title} />
    <meta name="title-zh" content={title_zh} />
    <meta name="description-en" content={description} />
    <meta name="description-zh" content={description_zh} />

    <!-- Primary Meta Tags -->
    <title>{effectiveTitle}</title>
    <meta name="title" content={effectiveTitle} />
    <meta name="description" content={effectiveDescription} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={effectiveTitle} />
    <meta property="og:description" content={effectiveDescription} />
    <meta property="og:image" content={getAssetUrl(image)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={effectiveTitle} />
    <meta property="twitter:description" content={effectiveDescription} />
    <meta property="twitter:image" content={getAssetUrl(image)} />

    <!-- Preconnect to Google Fonts & CDN with display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Noto+Serif+SC:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&display=swap" />

    <!-- Organization Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />

    <!-- Optional Page Specific Structured Data (Product / Breadcrumbs) -->
    {schemaJson && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaJson)} />
    )}

    <!-- Immediate Inline Language Pre-detection (Static Route > Browser > IP, prevents FOIC) -->
    <script is:inline>
      (function() {
        try {
          var path = window.location.pathname;
          var pathMatch = path.match(/^\/(zh|es|fr|de)(\/|$)/);
          if (pathMatch) {
            document.documentElement.lang = pathMatch[1];
            return;
          }
          var saved = localStorage.getItem('aura_preferred_lang');
          var target = 'en';
          if (saved && ['en', 'zh', 'es', 'fr', 'de'].indexOf(saved) !== -1) {
            target = saved;
          } else {
            var navLang = (navigator.languages && navigator.languages[0]) || navigator.language || '';
            var l = navLang.toLowerCase();
            if (l.indexOf('zh') === 0) target = 'zh';
            else if (l.indexOf('es') === 0) target = 'es';
            else if (l.indexOf('fr') === 0) target = 'fr';
            else if (l.indexOf('de') === 0) target = 'de';
          }
          document.documentElement.lang = target;
          if (target === 'zh') {
            var zhTitle = document.querySelector('meta[name="title-zh"]')?.getAttribute('content');
            if (zhTitle) document.title = zhTitle;
          }
        } catch (e) {}
      })();
    </script>

    <!-- Client-side i18n Runtime & IP Geolocation Resolver -->
    <script>
      import { resolveLanguage, applyTranslations, getSavedLang } from '../i18n/i18n-client';
      
      function syncDocumentMetadata(lang: string) {
        const isZh = lang === 'zh';
        const targetTitle = document.querySelector(`meta[name="title-${isZh ? 'zh' : 'en'}"]`)?.getAttribute('content');
        const targetDesc = document.querySelector(`meta[name="description-${isZh ? 'zh' : 'en'}"]`)?.getAttribute('content');
        
        if (targetTitle) document.title = targetTitle;
        if (targetDesc) {
          document.querySelector('meta[name="description"]')?.setAttribute('content', targetDesc);
        }
      }

      async function initI18n() {
        const path = window.location.pathname;
        const pathMatch = path.match(/^\/(zh|es|fr|de)(\/|$)/);
        if (pathMatch) {
          const pathLang = pathMatch[1] as any;
          document.documentElement.lang = pathLang;
          applyTranslations(pathLang);
          syncDocumentMetadata(pathLang);
          return;
        }

        const initialLang = (document.documentElement.lang || 'en') as any;
        applyTranslations(initialLang);
        syncDocumentMetadata(initialLang);

        // If user already has a saved manual choice, do not run background resolver
        if (getSavedLang()) return;

        const lang = await resolveLanguage();
        // Guard check: if user chose a language while resolveLanguage was waiting, DO NOT override!
        if (getSavedLang()) return;

        if (lang !== document.documentElement.lang) {
          applyTranslations(lang);
          syncDocumentMetadata(lang);
        }
      }

      window.addEventListener('aura-language-changed', (e: any) => {
        syncDocumentMetadata(e.detail.lang);
      });
      
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initI18n);
      } else {
        initI18n();
      }
    </script>
  </head>

  <body class="min-h-screen flex flex-col bg-[#faf9f6] text-neutral-900 font-sans antialiased selection:bg-brand-gold selection:text-brand-dark overflow-x-hidden">
    <!-- Main Global Header -->
    <Header />

    <!-- Page Body Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Global B2B Footer -->
    <Footer />

    <!-- Global RFQ Quote Modal -->
    <QuoteModal />

    <!-- Multi-Product RFQ Basket Drawer -->
    <InquiryDrawer />

    <!-- Global Floating WhatsApp & WeChat Contact -->
    <WhatsAppButton />

    <!-- Global WeChat Contact Modal -->
    <WeChatModal />
  </body>
</html>
